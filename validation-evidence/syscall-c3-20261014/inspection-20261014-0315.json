                    "args": [
                      "set -eu\ningress=http://aims-ingress-istio.istio-ingress.svc.cluster.local\n# Keep frontend coverage independent from API latency.  The prior\n# sequential loop could block on a slow API request and leave the\n# frontend model with empty wall-clock buckets even though collector\n# telemetry remained complete.\n(\n  while true; do\n    wget -q -O /dev/null -T 3 \"$ingress/\" || true\n    sleep \"${FRONTEND_INTERVAL_SECONDS:-0.30}\"\n  done\n) &\nfrontend_pid=$!\ncleanup() {\n  kill \"$frontend_pid\" 2>/dev/null || true\n  wait \"$frontend_pid\" 2>/dev/null || true\n}\ntrap cleanup EXIT INT TERM\ni=0\nwhile true; do\n  wget -q -O /dev/null -T 3 \"$ingress/api/health/\" || true\n  sleep \"${REQUEST_INTERVAL_SECONDS:-0.22}\"\n  wget -q -O /dev/null -T 3 \"$ingress/api/products/\" || true\n  sleep \"${REQUEST_INTERVAL_SECONDS:-0.22}\"\n  # Product IDs are UUIDs. Use a valid paginated read instead of the\n  # old /api/products/1/ request, which always returned HTTP 422.\n  wget -q -O /dev/null -T 3 \"$ingress/api/products/?page=1\" || true\n  sleep \"${REQUEST_INTERVAL_SECONDS:-0.22}\"\n  if [ $((i % 5)) -eq 0 ]; then\n    wget -q -O /dev/null -T 3 \"$ingress/api/auth/me/\" || true\n    sleep \"${REQUEST_INTERVAL_SECONDS:-0.22}\"\n    wget -q -O /dev/null -T 3 \"$ingress/api/cart/\" || true\n    sleep \"${REQUEST_INTERVAL_SECONDS:-0.22}\"\n  fi\n  i=$((i + 1))\ndone\n"
                    ],
