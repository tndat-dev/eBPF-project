                    "args": [
                      "set -eu\nwhile true; do\n  # Redis PING (RESP), read-only MinIO root, and bounded protocol/TCP\n  # handshakes. Server processes execute accept/read/write paths,\n  # while no persistent business state is changed.\n  printf '*2\\r\\n$4\\r\\nAUTH\\r\\n$%s\\r\\n%s\\r\\n*1\\r\\n$4\\r\\nPING\\r\\n' \\\n    \"${#REDIS_PASSWORD}\" \"$REDIS_PASSWORD\" | \\\n    nc -w 2 aims-redis 6379 >/dev/null 2>&1 || true\n  wget -q -O /dev/null -T 3 http://minio/minio/health/live || true\n  printf '' | nc -w 2 aims-postgres-cnpg-rw 5432 >/dev/null 2>&1 || true\n  printf '' | nc -w 2 aims-kafka-kafka-bootstrap 9092 >/dev/null 2>&1 || true\n  printf '' | nc -w 2 aims-rabbitmq 5672 >/dev/null 2>&1 || true\n  sleep \"${SLEEP_SECONDS:-2}\"\ndone\n"
                    ],
                    "command": [
                      "/bin/sh",
                      "-c"
                    ],
                    "env": [
                      {
                        "name": "SLEEP_SECONDS",
                        "value": "2"
                      },
                      {
