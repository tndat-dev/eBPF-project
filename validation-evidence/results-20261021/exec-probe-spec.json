      ],
      "probes": {
        "livenessProbe": {
          "entry": "sh",
          "period_seconds": 10,
          "command_prefix": "sh -ec RESP=\"$(redis-cli -h $(hostname) -p ${REDIS_PORT} -a ${REDIS_PASSWORD} pi"
        },
        "readinessProbe": {
          "entry": "sh",
          "period_seconds": 10,
          "command_prefix": "sh -ec RESP=\"$(redis-cli -h $(hostname) -p ${REDIS_PORT} -a ${REDIS_PASSWORD} pi"
        }
      }
    },
