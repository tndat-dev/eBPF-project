<mxfile host="drawio" agent="make_architecture_drawio.py" version="32.6.10"><diagram id="page-1" name="Overview (paper)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="620" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Ov-1" value="Each worker node (×3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=15;fontColor=#6C8EBF;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="1460" height="330" as="geometry"/></mxCell><mxCell id="Ov-2" value="&lt;b&gt;Application containers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;namespace production; one cgroup each; unmodified&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="200" height="170" as="geometry"/></mxCell><mxCell id="Ov-3" value="&lt;b&gt;eBPF probe (kernel)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;sys_enter, sys_exit, __seccomp_filter, sched_process_fork&lt;br&gt;32-bit token per call; per-thread 4-grams counted per (cgroup, 0.5 s window); lineage tag&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="275" y="70" width="330" height="170" as="geometry"/></mxCell><mxCell id="Ov-4" value="&lt;b&gt;Loader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;every 0.5 s drains the closed windows; SHA-256 and kernel proof checked at start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="220" height="170" as="geometry"/></mxCell><mxCell id="Ov-5" value="&lt;b&gt;Scoring worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;per-workload 4-gram count LM (Witten-Bell); s(W) = mean of the top surprisals; alarm if s(W) &gt; τ of the workload; one window fires&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="895" y="70" width="330" height="170" as="geometry"/></mxCell><mxCell id="Ov-6" value="&lt;b&gt;Decisions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;local disk; segments on NFS&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="70" width="200" height="170" as="geometry"/></mxCell><mxCell id="Ov-7" value="&lt;b&gt;Resolver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;pod UID → cgroup → workload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="265" width="200" height="80" as="geometry"/></mxCell><mxCell id="Ov-8" value="Master node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=15;fontColor=#B85450;container=0;" vertex="1" parent="1"><mxGeometry x="260" y="395" width="1220" height="150" as="geometry"/></mxCell><mxCell id="Ov-9" value="&lt;b&gt;Offline fit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;normal capture → counts → 5-fold cross-fit → Gumbel τ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="200" height="105" as="geometry"/></mxCell><mxCell id="Ov-10" value="&lt;b&gt;Tetragon&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;exec, fork and connect events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="280" y="425" width="200" height="105" as="geometry"/></mxCell><mxCell id="Ov-11" value="&lt;b&gt;RCA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;one case per delivered alert: process tree, ranked suspects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="515" y="425" width="300" height="105" as="geometry"/></mxCell><mxCell id="Ov-12" value="&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;of the cluster&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="850" y="425" width="200" height="105" as="geometry"/></mxCell><mxCell id="Ov-13" value="&lt;b&gt;Alert bridge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;follows alarm rows over SSH; one episode per container (gaps &lt; 15 s); push to Alertmanager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1085" y="425" width="375" height="105" as="geometry"/></mxCell><mxCell id="Ov-14" value="syscalls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;" edge="1" parent="1" source="Ov-2" target="Ov-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Ov-15" value="map" style="