<mxfile host="drawio" agent="make_architecture_drawio.py" version="32.6.10"><diagram id="page-1" name="1. Tổng quan hệ thống"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1150" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1.-1" value="&lt;b&gt;Sentinel Pulse: kiến trúc tổng thể (07/11/2026)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="1.-2" value="Phát hiện runtime trên Kubernetes từ syscall đếm trong kernel: ML lidds-ml-v3 (token + tree + support), cảnh báo qua Alertmanager, RCA từ sự kiện Tetragon. Khung tím đứt nét chỉ dùng khi đánh giá." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="1.-3" value="Cụm Kubernetes của lab: 6 VM trên ESXi · Ubuntu 24.04 · kernel 6.8.0 · Kubernetes v1.34 · Cilium · Istio ambient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#326CE5;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#326CE5;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1235" height="945" as="geometry"/></mxCell><mxCell id="1.-4" value="Mỗi worker (×3): k8s-worker1 .237 · k8s-worker4 .238 · k8s-worker3 .239" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#6C8EBF;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="700" as="geometry"/></mxCell><mxCell id="1.-5" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon;prIcon=node;verticalLabelPosition=bottom;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="785" y="116" width="40" height="39" as="geometry"/></mxCell><mxCell id="1.-6" value="namespace production: ứng dụng AIMS (21 workload, khoảng 80 pod)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;opacity=35;strokeColor=#D79B00;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="770" height="115" as="geometry"/></mxCell><mxCell id="1.-7" value="&lt;b&gt;frontend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="68" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-8" value="&lt;b&gt;API gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="161" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-9" value="&lt;b&gt;service Python&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="254" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-10" value="&lt;b&gt;PostgreSQL (CNPG)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="347" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-11" value="&lt;b&gt;Kafka&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="440" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-12" value="&lt;b&gt;RabbitMQ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="533" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-13" value="&lt;b&gt;Redis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="626" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-14" value="&lt;b&gt;MinIO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="719" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-15" value="Mỗi container là một cgroup: Pulse đếm syscall theo cgroup, không sửa ứng dụng hay pod." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="68" y="222" width="740" height="36" as="geometry"/></mxCell><mxCell id="1.-16" value="Kernel Linux 6.8 (eBPF, BTF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;opacity=35;strokeColor=#D6B656;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="280" width="770" height="160" as="geometry"/></mxCell><mxCell id="1.-17" value="&lt;b&gt;Probe eBPF của Pulse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;raw_tp/sys_enter: đếm mọi syscall theo cgroup&lt;br&gt;raw_tp/sys_exit: token lúc trả về (39 syscall)&lt;br&gt;fexit/__seccomp_filter: syscall bị seccomp bỏ qua&lt;br&gt;map: bộ đếm cgroup, trạng thái thread, 4-gram&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="305" width="300" height="120" as="geometry"/></mxCell><mxCell id="1.-18" value="&lt;b&gt;Allow-list cgroup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;map pulse_cgroups: chỉ cgroup production được đếm; cgroup khác thoát sau một lần tra map&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="305" width="200" height="120" as="geometry"/></mxCell><mxCell id="1.-19" value="&lt;b&gt;Tetragon (kprobe)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;exec, fork, file nhạy cảm, credential, namespace, kết nối, ptrace; 3 policy, chỉ production&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="305" width="180" height="120" as="geometry"/></mxCell><mxCell id="1.-20" value="User space của worker (unit systemd)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;opacity=35;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="455" width="770" height="340" as="geometry"/></mxCell><mxCell id="1.-21" value="&lt;b&gt;Loader C (pulse_counter_tokens_loader)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;khoá SHA-256 + proof theo kernel; mỗi 0,5 s: frame JSON gồm bộ đếm và 4-gram của cửa sổ đã đóng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="300" height="100" as="geometry"/></mxCell><mxCell id="1.-22" value="&lt;b&gt;sentinel-pulse-resolver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pod UID → container → cgroup → phiên bản workload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="1.-23" value="&lt;b&gt;Agent Tetragon&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DaemonSet, shareProcessNamespace; tetra getevents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="480" width="180" height="100" as="geometry"/></mxCell><mxCell id="1.-24" value="&lt;b&gt;Worker chấm điểm (pipeline/matched_worker.py, 3 core, 3 GB)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• kiểm toàn vẹn frame; 249 feature, ngữ cảnh 4 cửa sổ&lt;br&gt;• nhánh tree + support: model đóng băng theo workload&lt;br&gt;• nhánh token: Witten-Bell 4-gram theo workload&lt;br&gt;• ngưỡng Gumbel theo khối 60 s, α/3 mỗi nhánh; một cửa sổ vượt ngưỡng ở nhánh nào cũng báo&lt;br&gt;• ghi NFS bằng thread nền (AsyncSink), ngoài vòng chấm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="605" width="530" height="175" as="geometry"/></mxCell><mxCell id="1.-25" value="&lt;b&gt;Luồng decision local&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/var/lib/sentinel-pulse-live (đĩa của worker)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="615" width="180" height="160" as="geometry"/></mxCell><mxCell id="1.-26" value="Master (×3): .234 k8s-master · .235 · .236" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#B85450;container=0;" vertex="1" parent="1"><mxGeometry x="875" y="110" width="360" height="700" as="geometry"/></mxCell><mxCell id="1.-27" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon;prIcon=master;verticalLabelPosition=bottom;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1190" y="116" width="40" height="39" as="geometry"/></mxCell><mxCell id="1.-28" value="&lt;b&gt;Alert bridge (trên .234)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;đọc decision local của 3 worker qua SSH; gom đợt theo container; push API v2, thử lại 3 lần; phục vụ trang case&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="150" width="330" height="105" as="geometry"/></mxCell><mxCell id="1.-29" value="&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;kube-prometheus-stack; route theo nhãn notify&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="285" width="330" height="70" as="geometry"/></mxCell><mxCell id="1.-30" value="&lt;b&gt;RCA (trên .234)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;sự kiện Tetragon → ring SQLite 180 s; case cho mỗi cảnh báo Alertmanager đã nhận (30 s trước); xếp hạng nghi phạm; triage: tripwire / thao tác bảo mật / chỉ probe / binary mới / khác&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="385" width="330" height="125" as="geometry"/></mxCell><mxCell id="1.-31" value="&lt;b&gt;RCA viewer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/cases, bảng Grafana Infinity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="540" width="160" height="75" as="geometry"/></mxCell><mxCell id="1.-32" value="&lt;b&gt;Prometheus / Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;NodePort 32090 / 32300&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="540" width="160" height="75" as="geometry"/></mxCell><mxCell id="1.-33" value="&lt;b&gt;Planner + launcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CONFIG.json bất biến: hash model, chính sách, fixture, lịch tải, lịch trial&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="645" width="160" height="150" as="geometry"/></mxCell><mxCell id="1.-34" value="&lt;b&gt;Job phân tích (.234)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;systemd-run có MemoryMax; ablation, chấm LID-DS, replay; đọc NFS, repo, dữ liệu công khai; không chạy cùng lượt live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="645" width="160" height="150" as="geometry"/></mxCell><mxCell id="1.-35" value="&lt;b&gt;Tải normal (đánh giá)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4 generator trong namespace production gửi HTTP tới AIMS; chế độ steady, toolmix, peak, burst, recovery theo lịch đăng ký&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="400" height="110" as="geometry"/></mxCell><mxCell id="1.-36" value="&lt;b&gt;Chiến dịch tấn công (đánh giá)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kubectl exec fixture vào container: 21 workload × 5 kịch bản × tốc độ 1–24/s, 525 trial; mỗi trial: control 15 s → binary vô hại 15 s → tấn công 15 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="460" y="845" width="380" height="110" as="geometry"/></mxCell><mxCell id="1.-37" value="&lt;b&gt;NFS .233: /sentinel-pulse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/mnt/sentinel-pulse-archive; segment 30 phút mỗi worker: features, decisions, tokens, issues, TERMINAL.json (seal SHA-256); CONFIG.json, model bundle&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="110" width="410" height="160" as="geometry"/></mxCell><mxCell id="1.-38" value="&lt;b&gt;Người vận hành&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nhận cảnh báo (notify=immediate) hoặc xem dashboard; mở case RCA: nghi phạm, lý do, cây bằng chứng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1280" y="290" width="410" height="80" as="geometry"/></mxCell><mxCell id="1.-39" value="&lt;b&gt;Repo git (GitHub, main)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;code Pulse · protocol đăng ký trước · biên nhận JSON (validation-evidence/) · audit số liệu · đồ án LaTeX (thesis/) · notes/&lt;br&gt;checkout trên .234/.237/.238/.239 đồng bộ bằng git pull --ff-only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1280" y="400" width="410" height="130" as="geometry"/></mxCell><mxCell id="1.-40" value="&lt;b&gt;Dữ liệu công khai (offline)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LID-DS 2021 (15 kịch bản, development → official), CB-DS, LID-DS 2019 (cuối cùng)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1280" y="560" width="410" height="110" as="geometry"/></mxCell><mxCell id="1.-41" value="Chú giải" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="1280" y="700" width="330" height="232" as="geometry"/></mxCell><mxCell id="1.-42" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="732" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-43" value="Kernel: probe eBPF của Pulse" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="730" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-44" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="760" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-45" value="User space của Pulse (C, Python)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="758" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-46" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="788" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-47" value="ML lidds-ml-v3 (3 nhánh)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="786" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-48" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="816" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-49" value="Đường cảnh báo và RCA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="814" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-50" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="844" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-51" value="Thành phần có sẵn của cụm (Tetragon, K8s)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="842" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-52" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="872" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-53" value="Chỉ dùng khi đánh giá (đứt nét)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="870" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-54" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B3B3B3;dashed=1;fontColor=#888888;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="900" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-55" value="Đã bỏ khỏi ML / để sau (xám)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="898" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-56" value="syscall" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.137;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-7" target="1.-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-57" value="đọc map theo lô" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-17" target="1.-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-58" value="allowed-cgroups" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-22" target="1.-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-59" value="sự kiện" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-19" target="1.-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-60" value="frame JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.283;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-21" target="1.-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-61" value="cgroups.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.811;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-22" target="1.-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-62" value="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-24" target="1.-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-63" value="SSH, chỉ dòng báo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-25" target="1.-28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="655"/><mxPoint x="850" y="202"/></Array></mxGeometry></mxCell><mxCell id="1.-64" value="tetra getevents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-23" target="1.-30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="530"/><mxPoint x="865" y="447"/></Array></mxGeometry></mxCell><mxCell id="1.-65" value="POST /api/v2/alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-28" target="1.-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-66" value="cảnh báo đã nhận → case" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-29" target="1.-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.375;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-29" target="1.-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.242;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-30" target="1.-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-31" target="1.-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-70" value="features / decisions / tokens (NFS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-24" target="1.-37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="822"/><mxPoint x="1266" y="822"/><mxPoint x="1266" y="185"/></Array></mxGeometry></mxCell><mxCell id="1.-71" value="lịch trial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-33" target="1.-36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="900"/></Array></mxGeometry></mxCell><mxCell id="1.-72" value="&lt;b&gt;Đường dữ liệu chính:&lt;/b&gt; syscall của container → probe eBPF đếm theo cgroup và tạo token → loader đọc map mỗi 0,5 s → worker dựng feature, chấm 3 nhánh lidds-ml-v3 → decision ghi local và NFS → bridge gom đợt, đẩy vào Alertmanager → RCA dựng case cho đúng cảnh báo đó từ sự kiện Tetragon.&lt;br&gt;&lt;b&gt;Mục tiêu:&lt;/b&gt; recall ≥ 95%, precision ≥ 95%, p95 kernel → cảnh báo ≤ 3 s; gánh cảnh báo và binary vô hại bị gắn cờ càng thấp càng tốt. Tripwire A1 và chiết khấu theo replica tắt từ 01/11 (luật thêm sau khi ML chốt)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1035" width="1235" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="2. Probe eBPF trong kernel"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2.-1" value="&lt;b&gt;Probe eBPF: pulse_counter_tokens (make tokens)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="2.-2" value="Matched full-ID observable + token select1f của lidds-ml-v3. Không còn ftrace_ops nào (amendment 1–2 của token-probe-overhead-v1): chỉ raw tracepoint và fexit/__seccomp_filter có sẵn từ probe trước." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="2.-3" value="Một syscall của process trong container được giám sát" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;opacity=35;strokeColor=#D79B00;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1680" height="85" as="geometry"/></mxCell><mxCell id="2.-4" value="&lt;b&gt;syscall(nr, args)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;x86_64; mọi thread&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="280" height="50" as="geometry"/></mxCell><mxCell id="2.-5" value="&lt;b&gt;seccomp của container&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SECCOMP_RET_ERRNO → syscall không chạy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="95" width="280" height="50" as="geometry"/></mxCell><mxCell id="2.-6" value="&lt;b&gt;thân syscall (__x64_sys_*)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ret ≥ 0 hoặc −errno&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="2.-7" value="&lt;b&gt;trở về user space&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;syscall_exit_work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1050" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="2.-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-4" target="2.-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-9" value="cho phép" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-5" target="2.-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-6" target="2.-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-11" value="Chương trình BPF (kernel 6.8, CO-RE, BTF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;opacity=35;strokeColor=#D6B656;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="1680" height="485" as="geometry"/></mxCell><mxCell id="2.-12" value="&lt;b&gt;raw_tp/sys_enter → pulse_record_call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. cgroup_id → tra pulse_cgroups (miss: thoát ngay)&lt;br&gt;2. full_counts[nr]++ (0–1023)&lt;br&gt;3. bin cặp syscall (cùng thread, ≤ 5 s)++&lt;br&gt;4. tra hoặc tạo trạng thái thread (pulse_last_syscall, khoá pid_tgid)&lt;br&gt;5. syscall không trong bảng hook: phát token tên ngay&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;syscall có hook: tok_pending = 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="300" height="190" as="geometry"/></mxCell><mxCell id="2.-13" value="&lt;b&gt;fexit/__seccomp_filter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;syscall bị seccomp bỏ qua (result −1, không phải recheck) không tới sys_enter: đếm như sys_enter (seccomp_skipped_or_emulated++), token tên lúc vào, tok_pending = 0 nên sys_exit không phát lần hai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="370" y="200" width="280" height="190" as="geometry"/></mxCell><mxCell id="2.-14" value="&lt;b&gt;raw_tp/sys_exit → pulse_tok_sys_exit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chỉ khi tok_pending (cùng thread, cùng cgroup); nr = syscall_id đã ghi ở sys_enter. Token theo bảng 39 syscall (pulse_token_ids.h):&lt;br&gt;• lỗi, syscall thuộc nhóm ERR (26 + futex): tên + errno&lt;br&gt;• đọc/ghi thành công, ret &amp;gt; 0: tên + min(15, ⌊log2 ret⌋)&lt;br&gt;• open, openat, openat2, creat thành công: tên + chế độ (w nếu O_WRONLY | O_RDWR | O_CREAT | O_TRUNC | O_APPEND) + thư mục đầu&lt;br&gt;• còn lại: tên&lt;br&gt;&lt;b&gt;Thư mục đầu:&lt;/b&gt; fd trả về → struct file → đi ngược d_parent, vượt mount (bpf_loop ≤ 64 bước) tới gốc của task (gốc container) → FNV-1a của thành phần đầu, giữ 20 bit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="650" height="190" as="geometry"/></mxCell><mxCell id="2.-15" value="&lt;b&gt;.rodata.tokcfg&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;loader đặt trước khi nạp; verifier cắt nhánh tắt:&lt;br&gt;• futex_at_exit: futex là syscall có hook&lt;br&gt;• count_grams: cập nhật map 4-gram&lt;br&gt;B = exit-nofutex, C = exit, D = grams (điều kiện đo overhead; lượt live dùng D)&lt;br&gt;&lt;br&gt;--token-exit fexit: 39 trampoline fexit thay sys_exit (chỉ để so sánh)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="200" width="300" height="190" as="geometry"/></mxCell><mxCell id="2.-16" value="&lt;b&gt;pulse_tok_emit (gọi từ cả ba hook)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gram = (tok[0], tok[1], tok[2], token mới); khoá = (cgroup, cửa sổ = ktime / 0,5 s, gram); có trong map thì cộng nguyên tử, chưa có thì chèn BPF_NOEXIST (thua tranh chấp: tra lại); rồi dịch lịch sử của thread&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1310" height="85" as="geometry"/></mxCell><mxCell id="2.-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.467;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-4" target="2.-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-18" value="bỏ qua" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-5" target="2.-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.769;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-7" target="2.-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-20" value="token lúc vào" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.111;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-12" target="2.-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-21" value="token lúc vào" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.37;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-13" target="2.-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-22" value="token lúc ra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.787;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-14" target="2.-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-15" target="2.-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="462"/></Array></mxGeometry></mxCell><mxCell id="2.-24" value="&lt;b&gt;pulse_cgroups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PERCPU_HASH, 1024 cgroup: full_counts[1024], 64 bin cặp, seccomp_skipped (allow-list)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="300" height="100" as="geometry"/></mxCell><mxCell id="2.-25" value="&lt;b&gt;pulse_last_syscall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LRU_HASH 131.072 thread: cgroup, seen_ns, syscall_id, tok[3], tok_pending&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="540" width="330" height="100" as="geometry"/></mxCell><mxCell id="2.-26" value="&lt;b&gt;pulse_grams&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HASH 262.144 entry; khoá 32 byte (cgroup, cửa sổ, 4 token); giá trị: số lần&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="540" width="330" height="100" as="geometry"/></mxCell><mxCell id="2.-27" value="&lt;b&gt;pulse_stats, pulse_tok_stats&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lỗi chèn trạng thái/gram, walk quá sâu, tổng gram&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="540" width="260" height="100" as="geometry"/></mxCell><mxCell id="2.-28" value="lịch sử" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-16" target="2.-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-29" value="đếm gram" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.682;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-16" target="2.-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-30" value="pulse_cgroups do loader nạp từ allow-list của resolver; process ngoài allow-list thoát ở bước 1, nên chỉ trả chi phí một lần tra map." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1380" y="540" width="300" height="110" as="geometry"/></mxCell><mxCell id="2.-31" value="Bố cục token 32 bit (pulse_token_ids.h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#D6B656;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="820" height="150" as="geometry"/></mxCell><mxCell id="2.-32" value="&lt;b&gt;nr syscall (bit 23–31)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="216" height="40" as="geometry"/></mxCell><mxCell id="2.-33" value="&lt;b&gt;loại (21–22)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="256" y="712" width="72" height="40" as="geometry"/></mxCell><mxCell id="2.-34" value="&lt;b&gt;chi tiết (bit 0–20)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="328" y="712" width="480" height="40" as="geometry"/></mxCell><mxCell id="2.-35" value="loại 0: chỉ tên · 1: errno (bit 0–11) · 2: bucket kích thước 0–15 · 3: open (bit 20 = ghi, bit 0–19 = FNV thư mục; mã riêng cho &quot;/&quot;, &quot;rel&quot;, không rõ)&lt;br&gt;0xFFFFFFFF = ô lịch sử trống (đầu thread → gram ngắn hơn, như TokenLM offline)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="790" height="70" as="geometry"/></mxCell><mxCell id="2.-36" value="Loader (pulse_counter_loader.c, -DPULSE_TOKENS) và đầu ra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#6C8EBF;container=0;" vertex="1" parent="1"><mxGeometry x="860" y="680" width="840" height="310" as="geometry"/></mxCell><mxCell id="2.-37" value="&lt;b&gt;Khởi động&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kiểm layout map; đặt .rodata.tokcfg; nạp object; gắn sys_enter, fexit seccomp, sys_exit; nạp allow-list từ resolver; lỗi thì dừng (fail closed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880" y="712" width="380" height="100" as="geometry"/></mxCell><mxCell id="2.-38" value="&lt;b&gt;Mỗi 0,5 s (MONOTONIC + 20 ms)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cộng bộ đếm per-CPU mọi cgroup → cgroup_snapshot_extended; đọc pulse_grams theo lô, lấy cửa sổ đã đóng, xoá theo lô → token_grams&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1300" y="712" width="380" height="100" as="geometry"/></mxCell><mxCell id="2.-39" value="&lt;b&gt;Dòng JSON ra stdout (một frame)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{&quot;type&quot;:&quot;cgroup_snapshot_extended&quot;,&quot;cgroup_id&quot;:…,&quot;total&quot;:…,&quot;counts&quot;:{29 syscall},&quot;syscall_bins&quot;:[64],&quot;transition_bins&quot;:[64],&quot;full_counts&quot;:{…},&quot;seccomp_skipped_or_emulated&quot;:…}&lt;br&gt;{&quot;type&quot;:&quot;token_grams&quot;,&quot;contract&quot;:&quot;pulse-token-select1f-v1&quot;,&quot;cgroup_id&quot;:…,&quot;window&quot;:W,&quot;window_end&quot;:t,&quot;events&quot;:n,&quot;grams&quot;:[[t0,t1,t2,t3,count],…]}&lt;br&gt;{&quot;type&quot;:&quot;token_drain&quot;,…} · {&quot;type&quot;:&quot;stat&quot;,…} · {&quot;type&quot;:&quot;snapshot_end&quot;,&quot;targets&quot;:…,&quot;snapshots&quot;:…}&lt;br&gt;&lt;b&gt;Proof&lt;/b&gt; (scripts/token_probe_proof.py): tổng sự kiện token = tổng full_counts trong cgroup cô lập (422.316 = 422.316), token mẫu đúng, seccomp như proof matched.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880" y="828" width="800" height="150" as="geometry"/></mxCell><mxCell id="2.-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-37" target="2.-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page-3" name="3. Worker và ML lidds-ml-v3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3.-1" value="&lt;b&gt;Worker chấm điểm và lidds-ml-v3 trên cụm&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="3.-2" value="pipeline/matched_worker.py, một unit systemd mỗi worker. Ba nhánh, mỗi nhánh một ngưỡng theo workload; một cửa sổ vượt ngưỡng ở bất kỳ nhánh nào là báo động." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="3.-3" value="&lt;b&gt;Frame từ loader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;stdout, 0,5 s; dòng token_grams không ghi vào raw.jsonl&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="3.-4" value="&lt;b&gt;Kiểm toàn vẹn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;tổng full-ID = total; bin băm = phép chiếu; số target = số snapshot; nhịp 0,35–0,8 s (lệch: xoá lịch sử, ghi issue)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="300" height="120" as="geometry"/></mxCell><mxCell id="3.-5" value="&lt;b&gt;Metadata resolver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/run/sentinel-pulse/cgroups.json: workload_key = namespace/workload:container, pod_uid, revision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="610" y="90" width="260" height="120" as="geometry"/></mxCell><mxCell id="3.-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="3.-3" target="3.-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-5" target="3.-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-8" value="Nhánh đếm: tree + support (model đóng băng theo workload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#82B366;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="840" height="520" as="geometry"/></mxCell><mxCell id="3.-9" value="&lt;b&gt;249 feature mỗi cửa sổ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;58: log-count và tỉ lệ 29 syscall base29&lt;br&gt;5: tổng hợp (còn lại, tổng, nhạy cảm, seccomp)&lt;br&gt;64 bin ID syscall · 64 bin cặp syscall&lt;br&gt;58: trung bình, độ lệch 10 cửa sổ&lt;br&gt;ngữ cảnh = 3 cửa sổ trước + hiện tại (996 số)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="380" height="150" as="geometry"/></mxCell><mxCell id="3.-10" value="&lt;b&gt;Chấm theo batch (idle_batch, fast_forest)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;gom ngữ cảnh cùng workload, tối đa 256; đường nhanh bằng đúng scikit-learn (kiểm batch đầu, lệch thì quay về)&lt;br&gt;&lt;b&gt;tree:&lt;/b&gt; ExtraTrees normal vs normal bị làm hỏng → tree_score&lt;br&gt;&lt;b&gt;support:&lt;/b&gt; mức vượt khỏi vùng normal của từng feature → support_score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="450" y="280" width="390" height="150" as="geometry"/></mxCell><mxCell id="3.-11" value="&lt;b&gt;Nhánh đếm của v3 (detector/v3_policy.py, cfg v3_counts)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tree: logit(tree_score) &amp;gt; ngưỡng workload · support: support_score &amp;gt; ngưỡng workload&lt;br&gt;ngưỡng = Gumbel theo moment trên điểm lớn nhất của từng khối 60 s mỗi container (validation của lượt thu normal), α/3 = 0,0002/3 (scripts/analysis/count_branch_fit.py)&lt;br&gt;giữ kết quả của preview policy cũ ở policy_alert_preview&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="800" height="120" as="geometry"/></mxCell><mxCell id="3.-12" value="&lt;b&gt;Đã bỏ khỏi ML (01/11)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;joint p conformal + k2of2 α×5 + chiết khấu theo replica (trao đổi mặt nạ ID qua TCP 9479); calibration tự làm mới rolling-12-1 (không thắng)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B3B3B3;dashed=1;fontColor=#888888;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="390" height="130" as="geometry"/></mxCell><mxCell id="3.-13" value="&lt;b&gt;Tripwire A1 (để sau, so sánh có/không luật)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ID syscall ngoài tham chiếu 90 phút của workload và ngoài tập exec E (59 ID)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B3B3B3;dashed=1;fontColor=#888888;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="610" width="390" height="130" as="geometry"/></mxCell><mxCell id="3.-14" value="hiệu số bộ đếm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-4" target="3.-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="225"/><mxPoint x="230" y="225"/></Array></mxGeometry></mxCell><mxCell id="3.-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="3.-9" target="3.-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-16" value="tree_score, support_score" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-10" target="3.-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-17" value="Nhánh token (detector/token_model.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#82B366;container=0;" vertex="1" parent="1"><mxGeometry x="880" y="240" width="820" height="520" as="geometry"/></mxCell><mxCell id="3.-18" value="&lt;b&gt;token_window (collector/token_capture.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;kiểm contract, tổng count = events, ô trống chỉ ở đầu gram; gắn workload_key, pod, container, revision; bỏ cgroup ngoài production → tokens.jsonl&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="280" width="380" height="150" as="geometry"/></mxCell><mxCell id="3.-19" value="&lt;b&gt;CountTokenLM theo workload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;4-gram theo thread, Witten-Bell lùi tới P(syscall) × P(token | syscall), cộng ½; học từ số đếm gram (= TokenLM offline tới 1e-12)&lt;br&gt;điểm cửa sổ = trung bình 10 giá trị −log p lớn nhất (tính cả số lần)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1300" y="280" width="380" height="150" as="geometry"/></mxCell><mxCell id="3.-20" value="&lt;b&gt;TokenBranch (cfg tokens.models: model + sha256 + ngưỡng mỗi workload)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;token_score &amp;gt; ngưỡng → báo; ngưỡng = Gumbel theo khối 60 s mỗi container trên validation, α/3 (scripts/analysis/token_branch_fit.py)&lt;br&gt;ghi decision branch=token (candidate_alert_preview) vào decisions.jsonl + luồng local; token_scored_at để đo độ trễ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="460" width="780" height="120" as="geometry"/></mxCell><mxCell id="3.-21" value="&lt;b&gt;Bảng chữ select1f (protocol lidds-ml-v3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;errno của 27 syscall (stat, lstat, fstat, newfstatat, access, faccessat, open, openat, creat, read, write, writev, ioctl, connect, execve, fcntl, close, rename, renameat, sendfile, unlink, unlinkat, mkdir, kill, recvfrom, shutdown, futex); log2 cỡ trả về của đọc/ghi; chế độ + thư mục đầu của open. LID-DS 2021 official: 97,32% recall, 0,44% báo nhầm, p95 2,09 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#BDB76B;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="600" height="130" as="geometry"/></mxCell><mxCell id="3.-22" value="token_grams" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-4" target="3.-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="225"/><mxPoint x="1090" y="225"/></Array></mxGeometry></mxCell><mxCell id="3.-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="3.-18" target="3.-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-19" target="3.-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-25" value="&lt;b&gt;Decision của hệ thống = nhánh tree HOẶC support HOẶC token báo (một cửa sổ là đủ)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mỗi decision mang workload_key, pod_uid, container, window_start/end, preview_emitted_at, run_id, capture_segment; độ trễ kernel → cảnh báo = preview_emitted_at − window_end&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="1680" height="90" as="geometry"/></mxCell><mxCell id="3.-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-11" target="3.-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.94;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-20" target="3.-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-28" value="&lt;b&gt;NFS: segment 30 phút&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;features.jsonl · decisions.jsonl · tokens.jsonl · issues.jsonl · loader.log · TERMINAL.json (seal)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="400" height="110" as="geometry"/></mxCell><mxCell id="3.-29" value="&lt;b&gt;Đĩa local của worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decisions.jsonl cho bridge, RCA, campaign&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="910" width="300" height="110" as="geometry"/></mxCell><mxCell id="3.-30" value="&lt;b&gt;Ghi ngoài vòng chấm (async_sink)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;thread nền, fdatasync + FADV_DONTNEED mỗi 30 s; STATUS.json bất đồng bộ; dừng khi hết chỗ trống&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="780" y="910" width="450" height="110" as="geometry"/></mxCell><mxCell id="3.-31" value="&lt;b&gt;Khoá trước khi chấm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;kernel = proof; SHA-256 của loader và object; 13 file code chấm điểm = bản đóng băng; hash model bundle và chính sách; hash model token và ngưỡng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1260" y="910" width="440" height="110" as="geometry"/></mxCell><mxCell id="3.-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-25" target="3.-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-25" target="3.-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-34" value="&lt;b&gt;Lượt live tiếp theo (protocol pulse-live-v3-v1):&lt;/b&gt; thu normal 12 h với probe token (8 h học, 4 h validation) → fit model token và ngưỡng 3 nhánh → khoá → lượt live blind 24 h (525 trial). Tiêu chí: recall ≥ 95%, precision ≥ 95%, control ≤ 5%, p95 ≤ 3 s; báo cáo thêm binary vô hại bị gắn cờ và gánh cảnh báo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1040" width="1680" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="4. Cảnh báo và RCA"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="790" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4.-1" value="&lt;b&gt;Đường cảnh báo và truy nguyên nguyên nhân (RCA)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="4.-2" value="Bridge và RCA chạy trên .234 và chỉ đọc decision. Mã đợt cảnh báo = mã case RCA." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="4.-3" value="&lt;b&gt;Worker ×3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;decisions.jsonl local; chỉ dòng &quot;candidate_alert_preview&quot;:true (hoặc tripwire_alert) rời worker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="250" height="110" as="geometry"/></mxCell><mxCell id="4.-4" value="&lt;b&gt;Alert bridge (ops/alert_bridge.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• bám log decision của từng worker qua SSH&lt;br&gt;• gom đợt theo (pod_uid, container); hết đợt khi im lặng quá resolve_after&lt;br&gt;• push POST /api/v2/alerts lúc mở đợt, làm mới khi còn kéo dài; lỗi → thử lại 3 lần, cách 0,5 s&lt;br&gt;• đo độ trễ từ preview_emitted_at và window_end&lt;br&gt;• đường pull (gauge /metrics, scrape 5 s / 30 s) chỉ để so độ trễ: chậm hơn nhiều&lt;br&gt;• triggers.jsonl: dòng đầu của mỗi đợt đã giao&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="430" height="165" as="geometry"/></mxCell><mxCell id="4.-5" value="&lt;b&gt;Alertmanager (API v2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;SentinelPulseAnomaly (kèm chú thích RCA khi case xong, cùng nhãn); SentinelPulseTriage với nhãn rca_class, notify&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="300" height="110" as="geometry"/></mxCell><mxCell id="4.-6" value="&lt;b&gt;Route theo notify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;immediate: tripwire, thao tác bảo mật → /alertmanager/notify&lt;br&gt;dashboard: chỉ probe, binary mới, khác&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="220" width="300" height="90" as="geometry"/></mxCell><mxCell id="4.-7" value="&lt;b&gt;Người vận hành&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;thông báo ngay, hoặc xem dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1160" y="80" width="260" height="110" as="geometry"/></mxCell><mxCell id="4.-8" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;dashboard sentinel-pulse-alerts; bảng case qua Infinity (/cases.json)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1160" y="220" width="260" height="90" as="geometry"/></mxCell><mxCell id="4.-9" value="SSH tail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.23;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-3" target="4.-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-10" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.29;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-4" target="4.-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1" source="4.-5" target="4.-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-12" value="immediate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-6" target="4.-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="247"/><mxPoint x="1130" y="162"/></Array></mxGeometry></mxCell><mxCell id="4.-13" value="dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-6" target="4.-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-14" value="RCA (sentinel_pulse/rca)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#B85450;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="1680" height="370" as="geometry"/></mxCell><mxCell id="4.-15" value="&lt;b&gt;3 policy Tetragon (chỉ production)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;runtime:&lt;/b&gt; file nhạy cảm, credential, kết nối, namespace, ptrace&lt;br&gt;&lt;b&gt;fork&lt;/b&gt;&lt;br&gt;&lt;b&gt;flow:&lt;/b&gt; lần gửi trên socket đã mở, lấy mẫu 1 lần mỗi process mỗi 10 s&lt;br&gt;+ exec provenance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="300" height="135" as="geometry"/></mxCell><mxCell id="4.-16" value="&lt;b&gt;Subscriber&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tetra getevents của 3 worker, xoay vòng có giới hạn&lt;br&gt;ghép theo node, Pod UID, container, thời gian; process = exec_id (PID bị tái dùng)&lt;br&gt;ring SQLite 180 s; nhật ký exec 15 phút&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="320" height="135" as="geometry"/></mxCell><mxCell id="4.-17" value="&lt;b&gt;Dựng case (nhịp 0,25 s)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;từ cảnh báo Alertmanager đã nhận (triggers.jsonl); lấy 30 s trước cảnh báo&lt;br&gt;cùng container trong 300 s → cùng case; binary mới trong khoảng đó → case tiếp nối; giữ tối đa 20.000 case&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="330" height="135" as="geometry"/></mxCell><mxCell id="4.-18" value="&lt;b&gt;Xếp hạng nghi phạm (heuristic có lý do)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;binary mới trong workload sau mốc baseline +4 · thao tác credential / namespace / mount / ptrace +3 mỗi lần (tối đa 9) · binary chưa từng ghi nhận +2 · exec trong cửa sổ cảnh báo +2 · syscall thất bại +1 (tối đa 3) · cha của nghi phạm khác +1&lt;br&gt;ngoại lệ: hạ quyền setuid/setgid lúc khởi động; containerd-shim, runc không xếp hạng&lt;br&gt;phá hoà theo thời điểm khởi chạy: top-1 100% trên các trial blind&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1110" y="380" width="570" height="135" as="geometry"/></mxCell><mxCell id="4.-19" value="&lt;b&gt;Triage (ops/rca_view.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tripwire → notify ngay · security_operation → notify ngay · probe_only (mọi exec là probe Kubernetes của pod spec) → dashboard · new_binary → dashboard · other → dashboard&lt;br&gt;chỉ là quyết định giao tin: decision và mọi chỉ số đánh giá không đổi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="660" height="120" as="geometry"/></mxCell><mxCell id="4.-20" value="&lt;b&gt;Đầu ra của case&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&amp;lt;case_id&amp;gt;.json (cây bằng chứng) · .md · .svg; trang /cases, /cases/&amp;lt;id&amp;gt; (nghi phạm, lý do, binary, đích mạng, cây)&lt;br&gt;bridge push lại SentinelPulseAnomaly kèm chú thích RCA (khoảng 2,7 s sau cảnh báo)&lt;br&gt;cây cho thấy liên quan theo định danh và thời gian, không chứng minh nhân quả; RCA không tự xử lý pod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="560" width="940" height="120" as="geometry"/></mxCell><mxCell id="4.-21" value="sự kiện" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="4.-15" target="4.-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="4.-16" target="4.-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="4.-17" target="4.-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-24" value="cảnh báo đã nhận" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.106;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-5" target="4.-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="168"/></Array></mxGeometry></mxCell><mxCell id="4.-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-17" target="4.-19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="806" y="540"/><mxPoint x="634" y="540"/></Array></mxGeometry></mxCell><mxCell id="4.-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-18" target="4.-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-27" value="Lượt hệ thống cuối (25–26/10): 5.840/5.840 đợt tới Alertmanager (3 push lỗi, thử lại thành công); p95 kernel → cảnh báo 1,97 s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="725" width="1680" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-5" name="5. Học và đánh giá"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5.-1" value="&lt;b&gt;Quy trình chọn, xác nhận và đánh giá&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="5.-2" value="Chọn trên dữ liệu development, xác nhận một lần trên dữ liệu khoá; mỗi bước có protocol đăng ký trước và biên nhận JSON trong repo. Không chạy luật (tripwire, novelty, bỏ phiếu) cho tới khi ML chốt." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="5.-3" value="&lt;b&gt;LID-DS 2021 development + CB-DS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chọn bảng chữ token, nhánh, ngưỡng; 15 kịch bản; CB-DS 891/891 tấn công, 2/1.410 báo nhầm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-4" value="&lt;b&gt;LID-DS 2021 official&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lidds-ml-v3: 97,32% recall (1.237/1.271), 0,44% báo nhầm, precision 97,25%, p95 2,09 s; lần chấm official thứ 2, đã khai báo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="5.-3" target="5.-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-6" value="&lt;b&gt;Thu normal trên cụm (12 h)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pulse-token-capture: 8 h học model token, 4 h validation cho ngưỡng 3 nhánh; chưa chạy (chờ ablation vòng 2 xong)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-4" target="5.-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-8" value="&lt;b&gt;Lượt live blind (24 h)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pulse-live-v3: 525 trial, tốc độ chính 6/12/24 mỗi giây; recall, precision, control, p95, binary vô hại, gánh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-6" target="5.-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-10" value="&lt;b&gt;LID-DS 2019 (cuối cùng)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chấm một lần, protocol lidds2019-confirmation-v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1140" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-8" target="5.-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-12" value="&lt;b&gt;So sánh có / không luật&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tripwire A1 và các luật khác thêm vào ML đã chốt; mở lại baseline học sâu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B3B3B3;dashed=1;fontColor=#888888;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1420" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-10" target="5.-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-14" value="Offline (máy phân tích .234, systemd-run có giới hạn bộ nhớ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#9673A6;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="830" height="420" as="geometry"/></mxCell><mxCell id="5.-15" value="&lt;b&gt;Chuyển đổi và chấm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sentinel_pulse/lidds: convert.py, signals.py&lt;br&gt;lidds_ml_token_alphabets.py (token), lidds_ml_scores.py --all-windows (tree, support)&lt;br&gt;lidds_ml_v2.py --token-column select1f --protocol lidds-ml-v3.json (chọn và chấm)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="380" height="170" as="geometry"/></mxCell><mxCell id="5.-16" value="&lt;b&gt;Ngưỡng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gumbel theo moment trên điểm lớn nhất mỗi bản ghi validation, mỗi nhánh α/3, α = 0,0002; bằng oracle một mức chung ở báo nhầm 0,6–2%; tốt hơn Gumbel MLE, GEV, normal, đuôi mũ&lt;br&gt;trên cụm: khối thời gian 60 s mỗi container thay cho bản ghi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="390" height="170" as="geometry"/></mxCell><mxCell id="5.-17" value="&lt;b&gt;Kiểm thêm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ablation syscall theo kiểu bỏ một (vòng 2: 3 seed, 45 cấu hình, Holm)&lt;br&gt;LSTM lớn không hơn n-gram tổng thể&lt;br&gt;thứ tự phát token như probe: 530/544 development&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="380" height="170" as="geometry"/></mxCell><mxCell id="5.-18" value="&lt;b&gt;Overhead probe token (token-probe-overhead-v1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;benchmark syscall tĩnh, 5 vòng, 3 worker, xoay điều kiện: off / A / B / C / D / D không giám sát&lt;br&gt;lần 1 fexit → va chạm kprobe Tetragon; lần 2 sys_exit; lần 3 đi ngược dentry; báo cáo, không đạt/trượt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="440" y="520" width="390" height="170" as="geometry"/></mxCell><mxCell id="5.-19" value="Trên cụm (lượt live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#9673A6;container=0;" vertex="1" parent="1"><mxGeometry x="870" y="290" width="830" height="420" as="geometry"/></mxCell><mxCell id="5.-20" value="&lt;b&gt;Planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;plan_matched_run.py --token-build --token-models --v3-counts → CONFIG.json bất biến; launcher cài worker, RCA, bridge, traffic, campaign&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="890" y="330" width="380" height="170" as="geometry"/></mxCell><mxCell id="5.-21" value="&lt;b&gt;Fit sau lượt thu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;token_branch_fit.py → MODELS.json (model token + ngưỡng)&lt;br&gt;count_branch_fit.py → ngưỡng tree, support&lt;br&gt;khoá sha256 trước lượt live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1290" y="330" width="390" height="170" as="geometry"/></mxCell><mxCell id="5.-22" value="&lt;b&gt;Chấm lượt live&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;trial phát hiện khi có báo động trong [start, start + 15 s]; đợt = báo động cùng container cách nhau &lt; 15 s; gánh = đợt / replica-giờ ngoài khoảng campaign; Wilson, bootstrap theo workload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="890" y="520" width="380" height="170" as="geometry"/></mxCell><mxCell id="5.-23" value="&lt;b&gt;Kết quả hệ thống cuối (ML cũ + tripwire)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pulse-final-system-confirm 25–26/10: recall 99,4%, precision 99,4%, control 0,6%, p95 1,97 s; binary vô hại bị gắn cờ 89,5% → lý do làm ML token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B3B3B3;dashed=1;fontColor=#888888;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1290" y="520" width="390" height="170" as="geometry"/></mxCell><mxCell id="5.-24" value="Bằng chứng và tài liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1680" height="230" as="geometry"/></mxCell><mxCell id="5.-25" value="&lt;b&gt;Protocol&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sentinel_pulse/protocol/*.json, đăng ký trước khi có dữ liệu; amendment ghi rõ lý do&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-26" value="&lt;b&gt;Biên nhận&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;validation-evidence/results-YYYYMMDD/*: JSON, bảng, log; seal SHA-256 của segment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-27" value="&lt;b&gt;Audit số liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scripts/audit/headline_numbers.py: mọi số trong bản LaTeX khớp biên nhận (48/48)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-28" value="&lt;b&gt;Đồ án&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;thesis/ (LaTeX, tectonic); báo cáo và slide họp trong docs/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1030" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-29" value="&lt;b&gt;Ghi chép&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;notes/STATE.md (trạng thái), notes/WORKLOG.md (nhật ký từng bước)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1360" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-30" value="Nguyên tắc: chọn trên development, official và lượt live chỉ để xác nhận; mỗi lần chấm lại official phải khai báo; không job nặng nào chạy cùng lượt live; số liệu chỉ lấy từ biên nhận." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1640" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
