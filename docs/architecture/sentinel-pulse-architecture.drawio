<mxfile host="drawio" agent="make_architecture_drawio.py" version="32.6.10"><diagram id="page-1" name="1. Tổng quan hệ thống"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1260" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1.-1" value="&lt;b&gt;Sentinel Pulse: kiến trúc tổng thể (19/11/2026, lượt live cuối)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="1.-2" value="Phát hiện runtime trên Kubernetes bằng mô hình ngôn ngữ trên token syscall do eBPF dựng trong kernel (lidds-ml-v5-t3), cảnh báo qua Alertmanager. Khung tím đứt nét chỉ dùng khi đánh giá." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="1.-3" value="Cụm Kubernetes của lab: 6 VM trên ESXi · Ubuntu 24.04 · kernel 6.8.0 · Kubernetes v1.34 · Cilium · Istio ambient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#326CE5;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#326CE5;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1235" height="945" as="geometry"/></mxCell><mxCell id="1.-4" value="Mỗi worker (×3): k8s-worker1 .237 · k8s-worker4 .238 · k8s-worker3 .239" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#6C8EBF;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="700" as="geometry"/></mxCell><mxCell id="1.-5" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon;prIcon=node;verticalLabelPosition=bottom;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="785" y="116" width="40" height="39" as="geometry"/></mxCell><mxCell id="1.-6" value="namespace production: ứng dụng AIMS (21 workload, khoảng 80 pod)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;opacity=35;strokeColor=#D79B00;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="770" height="115" as="geometry"/></mxCell><mxCell id="1.-7" value="&lt;b&gt;frontend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="68" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-8" value="&lt;b&gt;API gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="161" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-9" value="&lt;b&gt;service Python&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="254" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-10" value="&lt;b&gt;PostgreSQL (CNPG)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="347" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-11" value="&lt;b&gt;Kafka&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="440" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-12" value="&lt;b&gt;RabbitMQ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="533" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-13" value="&lt;b&gt;Redis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="626" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-14" value="&lt;b&gt;MinIO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="719" y="175" width="86" height="40" as="geometry"/></mxCell><mxCell id="1.-15" value="Mỗi container là một cgroup: Pulse dựng token theo cgroup và thread, không sửa ứng dụng hay pod." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="68" y="222" width="740" height="36" as="geometry"/></mxCell><mxCell id="1.-16" value="Kernel Linux 6.8 (eBPF, BTF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;opacity=35;strokeColor=#D6B656;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="280" width="770" height="160" as="geometry"/></mxCell><mxCell id="1.-17" value="&lt;b&gt;Probe eBPF của Pulse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;raw_tp/sys_enter: allow-list, trạng thái thread, token lúc vào&lt;br&gt;raw_tp/sys_exit: token lúc trả về (39 syscall)&lt;br&gt;fexit/__seccomp_filter: syscall bị seccomp bỏ qua&lt;br&gt;raw_tp/sched_process_fork: thẻ dòng dõi native/session&lt;br&gt;map: trạng thái thread, 4-gram theo (cgroup, cửa sổ, dòng dõi)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_counter.bpf.c,&lt;br&gt;pulse_tokens.bpf.h, pulse_token_ids.h&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="305" width="300" height="120" as="geometry"/></mxCell><mxCell id="1.-18" value="&lt;b&gt;Allow-list cgroup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;map pulse_cgroups: chỉ cgroup production được theo dõi; cgroup khác thoát sau một lần tra map&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/&lt;br&gt;pulse_counter.bpf.c (map pulse_cgroups); nạp: pulse_counter_loader.c (refresh_targets)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="305" width="410" height="120" as="geometry"/></mxCell><mxCell id="1.-19" value="User space của worker (unit systemd)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;opacity=35;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="455" width="770" height="340" as="geometry"/></mxCell><mxCell id="1.-20" value="&lt;b&gt;Loader C (pulse_counter_tokens_loader)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;khoá SHA-256 + proof theo kernel; mỗi 0,5 s: dòng token_grams cho mỗi (cgroup, cửa sổ đã đóng)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_counter_loader.c&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="300" height="100" as="geometry"/></mxCell><mxCell id="1.-21" value="&lt;b&gt;sentinel-pulse-resolver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pod UID → container → cgroup → phiên bản workload&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/collector/cgroup_resolver.py; unit: sentinel_pulse/systemd/&lt;br&gt;sentinel-pulse-resolver.service&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="410" height="100" as="geometry"/></mxCell><mxCell id="1.-22" value="&lt;b&gt;Worker chấm điểm (pipeline/matched_worker.py, 3 core, 3 GB)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• kiểm hợp đồng của cửa sổ token; gắn workload, Pod, container&lt;br&gt;• mô hình ngôn ngữ 4-gram Witten-Bell của workload (khoá SHA-256)&lt;br&gt;• điểm = trung bình 3 giá trị −ln p lớn nhất (top của MODELS.json)&lt;br&gt;• ngưỡng Gumbel trên điểm giữ ra (khối 60 s, cross-fit 5 fold); một cửa sổ vượt ngưỡng là báo&lt;br&gt;• map gram đầy (insert_fail tăng) → báo cửa sổ nặng nhất của frame (D1)&lt;br&gt;• ghi NFS bằng thread nền (AsyncSink), ngoài vòng chấm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/matched_worker.py, sentinel_pulse/detector/token_model.py,&lt;br&gt;sentinel_pulse/collector/token_capture.py, sentinel_pulse/pipeline/async_sink.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="605" width="530" height="175" as="geometry"/></mxCell><mxCell id="1.-23" value="&lt;b&gt;Luồng decision local&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/var/lib/sentinel-pulse-live (đĩa của worker)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/&lt;br&gt;matched_worker.py (stream_root)&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="615" width="180" height="160" as="geometry"/></mxCell><mxCell id="1.-24" value="Master (×3): .234 k8s-master · .235 · .236" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#B85450;container=0;" vertex="1" parent="1"><mxGeometry x="875" y="110" width="360" height="700" as="geometry"/></mxCell><mxCell id="1.-25" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;fillColor=#2875E2;strokeColor=#ffffff;points=[];shape=mxgraph.kubernetes.icon;prIcon=master;verticalLabelPosition=bottom;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1190" y="116" width="40" height="39" as="geometry"/></mxCell><mxCell id="1.-26" value="&lt;b&gt;Alert bridge (trên .234)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;đọc decision local của 3 worker qua SSH; gom đợt theo container; push API v2; đợt chưa giao giữ trong hàng đợi bền, thử lại tới 1 giờ (D3); nhãn stream native/session&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ops/alert_bridge.py; scripts/alert_bridge.sh&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="150" width="330" height="105" as="geometry"/></mxCell><mxCell id="1.-27" value="&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;kube-prometheus-stack; gửi thông báo cho người vận hành&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: testbed/k8s/monitoring/sentinel-pulse-alerting.yaml&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="285" width="330" height="70" as="geometry"/></mxCell><mxCell id="1.-28" value="&lt;b&gt;Prometheus / Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;scrape gauge /metrics của bridge (đường pull, để so độ trễ); dashboard; NodePort 32090 / 32300&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: testbed/k8s/monitoring/sentinel-pulse-dashboard.json&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="385" width="330" height="90" as="geometry"/></mxCell><mxCell id="1.-29" value="&lt;b&gt;Planner + launcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CONFIG.json bất biến: hash mô hình, probe, fixture, lịch tải, lịch trial; diễn tập trước lượt; ghi sự kiện K8s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/&lt;br&gt;plan_matched_run.py,&lt;br&gt;scripts/launch_run.sh,&lt;br&gt;scripts/k8s_events_record.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="890" y="645" width="160" height="150" as="geometry"/></mxCell><mxCell id="1.-30" value="&lt;b&gt;Job phân tích (.234)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;systemd-run có MemoryMax; học mô hình (token_branch_fit.py), chấm LID-DS; đọc NFS, repo, dữ liệu công khai; không chạy cùng lượt live&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/analysis/&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1060" y="645" width="160" height="150" as="geometry"/></mxCell><mxCell id="1.-31" value="&lt;b&gt;Tải normal (đánh giá)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4 generator trong namespace production gửi HTTP tới AIMS; chế độ steady, toolmix, peak, burst, recovery theo lịch đăng ký&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/matched_traffic.py,&lt;br&gt;testbed/traffic/set_aims_traffic_regime.sh&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="400" height="110" as="geometry"/></mxCell><mxCell id="1.-32" value="&lt;b&gt;Chiến dịch tấn công (đánh giá)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;lượt cuối 945 trial: 21 workload × 5 kịch bản × tốc độ 0,1–24/s, pha loãng PAD 300, bật-tắt 10 s; mỗi trial: control 15 s rồi theo thứ tự có seed: lệnh admin, binary vô hại, tấn công, lotl, event-generator&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/attack/preview_campaign.py,&lt;br&gt;testbed/attack/runtime_attack_with_benign_control.c&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="460" y="845" width="380" height="110" as="geometry"/></mxCell><mxCell id="1.-33" value="&lt;b&gt;NFS .233: /sentinel-pulse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/mnt/sentinel-pulse-archive; segment 30 phút mỗi worker: decisions, tokens, issues, TERMINAL.json (seal SHA-256); CONFIG.json, mô hình token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: ghi bởi sentinel_pulse/pipeline/matched_worker.py; nén: scripts/&lt;br&gt;compress_raw_frames.py&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="110" width="410" height="160" as="geometry"/></mxCell><mxCell id="1.-34" value="&lt;b&gt;Người vận hành&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nhận thông báo từ Alertmanager hoặc xem dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1280" y="290" width="410" height="80" as="geometry"/></mxCell><mxCell id="1.-35" value="&lt;b&gt;Repo git (GitHub, main)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;code Pulse · protocol đăng ký trước · biên nhận JSON (validation-evidence/) · audit số liệu · đồ án LaTeX (thesis/) · notes/&lt;br&gt;checkout trên .234/.237/.238/.239 đồng bộ bằng git pull --ff-only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/sync_cluster_checkouts.sh&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1280" y="400" width="410" height="130" as="geometry"/></mxCell><mxCell id="1.-36" value="&lt;b&gt;Dữ liệu công khai (offline)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LID-DS 2021 (15 kịch bản, development → official), CB-DS, LID-DS 2019 (development 30% / holdout 70%)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/lidds/scripts/analysis/lidds_*.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1280" y="560" width="410" height="110" as="geometry"/></mxCell><mxCell id="1.-37" value="Chú giải" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="1280" y="700" width="330" height="232" as="geometry"/></mxCell><mxCell id="1.-38" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="732" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-39" value="Kernel: probe eBPF của Pulse" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="730" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-40" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1292" y="760" width="26" height="18" as="geometry"/></mxCell><mxCell id="1.-41" value="User space của Pulse (C, Python)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1326" y="758" width="280" height="22" as="geometry"/></mxCell><mxCell id="1.-42" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1