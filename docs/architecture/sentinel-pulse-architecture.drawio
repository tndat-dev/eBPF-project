rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-21" target="1.-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-76" value="cửa sổ token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.283;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-20" target="1.-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-77" value="cgroups.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.811;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-21" target="1.-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-78" value="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-22" target="1.-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-79" value="SSH, chỉ dòng báo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-23" target="1.-26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="655"/><mxPoint x="850" y="202"/></Array></mxGeometry></mxCell><mxCell id="1.-80" value="POST /api/v2/alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-26" target="1.-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.375;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-27" target="1.-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1.-82" value="decisions / tokens (NFS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-22" target="1.-33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="822"/><mxPoint x="1266" y="822"/><mxPoint x="1266" y="185"/></Array></mxGeometry></mxCell><mxCell id="1.-83" value="lịch trial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1.-29" target="1.-32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="900"/></Array></mxGeometry></mxCell><mxCell id="1.-84" value="&lt;b&gt;Đường dữ liệu chính:&lt;/b&gt; syscall của container → probe eBPF dựng token, đếm 4-gram theo thread → loader đọc map mỗi 0,5 s → worker chấm mô hình token của workload → decision ghi local và NFS → bridge gom đợt, đẩy vào Alertmanager → người vận hành.&lt;br&gt;&lt;b&gt;Mục tiêu:&lt;/b&gt; recall ≥ 95%, precision ≥ 95%, p95 kernel → cảnh báo ≤ 3 s; gánh cảnh báo và binary vô hại bị gắn cờ càng thấp càng tốt. Kết quả (lidds-ml-v5-t3): LID-DS 2021 official 97,25% / 0,19% báo nhầm, p95 1,54 s; LID-DS 2019 holdout 97,15% (dung sai nhãn 1 s), p95 10,95 s. Live v6 (lidds-ml-v5): tốc độ chính 315/315, precision 99,68%, p95 0,45 s. Lượt cuối pulse-live-final-1119 chạy 19/11–21/11." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1035" width="1235" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="2. Probe eBPF trong kernel"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1010" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2.-1" value="&lt;b&gt;Probe eBPF: pulse_counter_tokens (make tokens)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="2.-2" value="Token select1f cho mô hình lidds-ml-v5-t3; build pulse-tokens-final-f8ccbb2. Không có ftrace_ops nào ngoài fexit/__seccomp_filter: ba raw tracepoint (sys_enter, sys_exit, sched_process_fork). Bộ đếm syscall theo cgroup còn trong build, không dùng để báo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="2.-3" value="Một syscall của process trong container được giám sát" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;opacity=35;strokeColor=#D79B00;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1680" height="85" as="geometry"/></mxCell><mxCell id="2.-4" value="&lt;b&gt;syscall(nr, args)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;x86_64; mọi thread&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="280" height="50" as="geometry"/></mxCell><mxCell id="2.-5" value="&lt;b&gt;seccomp của container&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SECCOMP_RET_ERRNO → syscall không chạy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="95" width="280" height="50" as="geometry"/></mxCell><mxCell id="2.-6" value="&lt;b&gt;thân syscall (__x64_sys_*)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ret ≥ 0 hoặc −errno&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="2.-7" value="&lt;b&gt;trở về user space&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;syscall_exit_work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1050" y="95" width="300" height="50" as="geometry"/></mxCell><mxCell id="2.-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-4" target="2.-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-9" value="cho phép" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-5" target="2.-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-6" target="2.-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-11" value="Chương trình BPF (kernel 6.8, CO-RE, BTF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;opacity=35;strokeColor=#D6B656;dashed=1;verticalAlign=top;align=right;spacingRight=8;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="1680" height="485" as="geometry"/></mxCell><mxCell id="2.-12" value="&lt;b&gt;raw_tp/sys_enter → pulse_record_call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. cgroup_id → tra pulse_cgroups (miss: thoát ngay)&lt;br&gt;2. full_counts[nr]++ (giữ lại, không dùng để báo)&lt;br&gt;3. bin cặp syscall++ (giữ lại, không dùng để báo)&lt;br&gt;4. tra hoặc tạo trạng thái thread (pulse_last_syscall, khoá pid_tgid)&lt;br&gt;5. syscall không trong bảng hook: phát token tên ngay&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;syscall có hook: tok_pending = 1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_counter.bpf.c&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="300" height="190" as="geometry"/></mxCell><mxCell id="2.-13" value="&lt;b&gt;fexit/__seccomp_filter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;syscall bị seccomp bỏ qua (result −1, không phải recheck) không tới sys_enter: đếm như sys_enter (seccomp_skipped_or_emulated++), token tên lúc vào, tok_pending = 0 nên sys_exit không phát lần hai&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/&lt;br&gt;pulse_counter.bpf.c (pulse_seccomp_skip)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="370" y="200" width="280" height="190" as="geometry"/></mxCell><mxCell id="2.-14" value="&lt;b&gt;raw_tp/sys_exit → pulse_tok_sys_exit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chỉ khi tok_pending (cùng thread, cùng cgroup); nr = syscall_id đã ghi ở sys_enter. Token theo bảng 39 syscall (pulse_token_ids.h):&lt;br&gt;• lỗi, syscall thuộc nhóm ERR (26 + futex): tên + errno&lt;br&gt;• đọc/ghi thành công, ret &amp;gt; 0: tên + min(15, ⌊log2 ret⌋)&lt;br&gt;• open, openat, openat2, creat thành công: tên + chế độ (w nếu O_WRONLY | O_RDWR | O_CREAT | O_TRUNC | O_APPEND) + thư mục đầu&lt;br&gt;• còn lại: tên&lt;br&gt;&lt;b&gt;Thư mục đầu:&lt;/b&gt; fd trả về → struct file → đi ngược d_parent, vượt mount (bpf_loop ≤ 64 bước) tới gốc của task (gốc container) → FNV-1a của thành phần đầu, giữ 20 bit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_tokens.bpf.h (pulse_tok_return, pulse_tok_dir_of_fd); bảng: pulse_token_ids.h&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="650" height="190" as="geometry"/></mxCell><mxCell id="2.-15" value="&lt;b&gt;.rodata.tokcfg&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;loader đặt trước khi nạp; verifier cắt nhánh tắt:&lt;br&gt;• futex_at_exit · • count_grams&lt;br&gt;B = exit-nofutex, C = exit, D = grams (lượt live dùng D)&lt;br&gt;Biến thể 39 trampoline fexit đã bỏ (va chạm kprobe Tetragon)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/&lt;br&gt;pulse_tokens.bpf.h (pulse_tok_config)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="200" width="300" height="150" as="geometry"/></mxCell><mxCell id="2.-16" value="&lt;b&gt;raw_tp/sched_process_fork&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chạy trong process cha: con nhận thẻ dòng dõi của cha (native = cây process của workload, session = vào qua runtime exec) và lịch sử token rỗng, trước khi chạy; thẻ là telemetry, không dùng để báo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code:&lt;br&gt;sentinel_pulse/ebpf/pulse_tokens.bpf.h (pulse_tok_fork,&lt;br&gt;pulse_tok_lineage)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="365" width="300" height="140" as="geometry"/></mxCell><mxCell id="2.-17" value="&lt;b&gt;pulse_tok_emit (gọi từ cả ba hook)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gram = (tok[0], tok[1], tok[2], token mới); khoá = (cgroup, cửa sổ = ktime / 0,5 s, gram); có trong map thì cộng nguyên tử, chưa có thì chèn BPF_NOEXIST (thua tranh chấp: tra lại); rồi dịch lịch sử của thread&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_tokens.bpf.h&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1310" height="85" as="geometry"/></mxCell><mxCell id="2.-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.467;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-4" target="2.-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-19" value="bỏ qua" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-5" target="2.-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.769;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-7" target="2.-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-21" value="token lúc vào" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.111;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-12" target="2.-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-22" value="token lúc vào" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.37;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-13" target="2.-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-23" value="token lúc ra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.787;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-14" target="2.-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-15" target="2.-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1365" y="335"/><mxPoint x="1365" y="437"/></Array></mxGeometry></mxCell><mxCell id="2.-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-16" target="2.-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-26" value="&lt;b&gt;pulse_cgroups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PERCPU_HASH, 1024 cgroup: allow-list; full_counts, 64 bin cặp, seccomp_skipped (giữ lại, không dùng để báo)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_counter.bpf.c&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="300" height="100" as="geometry"/></mxCell><mxCell id="2.-27" value="&lt;b&gt;pulse_last_syscall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LRU_HASH 131.072 thread: cgroup, seen_ns, syscall_id, tok[3], tok_pending, thẻ dòng dõi&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_counter.bpf.c&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="540" width="330" height="100" as="geometry"/></mxCell><mxCell id="2.-28" value="&lt;b&gt;pulse_grams&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HASH 262.144 entry; khoá 32 byte (cgroup, cửa sổ, 4 token, dòng dõi); giá trị: số lần&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_tokens.bpf.h&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="540" width="330" height="100" as="geometry"/></mxCell><mxCell id="2.-29" value="&lt;b&gt;pulse_stats, pulse_tok_stats&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lỗi chèn trạng thái/gram (insert_fail tăng → cảnh báo map đầy, D1), walk quá sâu, tổng gram&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_counter.bpf.c,&lt;br&gt;pulse_tokens.bpf.h&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="540" width="260" height="100" as="geometry"/></mxCell><mxCell id="2.-30" value="lịch sử" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-17" target="2.-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-31" value="đếm gram" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.682;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2.-17" target="2.-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-32" value="pulse_cgroups do loader nạp từ allow-list của resolver; process ngoài allow-list thoát ở bước 1, nên chỉ trả chi phí một lần tra map." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1380" y="540" width="300" height="110" as="geometry"/></mxCell><mxCell id="2.-33" value="Bố cục token 32 bit (pulse_token_ids.h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6B656;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#D6B656;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="820" height="150" as="geometry"/></mxCell><mxCell id="2.-34" value="&lt;b&gt;nr syscall (bit 23–31)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="216" height="40" as="geometry"/></mxCell><mxCell id="2.-35" value="&lt;b&gt;loại (21–22)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="256" y="712" width="72" height="40" as="geometry"/></mxCell><mxCell id="2.-36" value="&lt;b&gt;chi tiết (bit 0–20)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="328" y="712" width="480" height="40" as="geometry"/></mxCell><mxCell id="2.-37" value="loại 0: chỉ tên · 1: errno (bit 0–11) · 2: bucket kích thước 0–15 · 3: open (bit 20 = ghi, bit 0–19 = FNV thư mục; mã riêng cho &quot;/&quot;, &quot;rel&quot;, không rõ)&lt;br&gt;0xFFFFFFFF = ô lịch sử trống (đầu thread → gram ngắn hơn, như TokenLM offline)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="790" height="70" as="geometry"/></mxCell><mxCell id="2.-38" value="Loader (pulse_counter_loader.c, -DPULSE_TOKENS) và đầu ra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#6C8EBF;container=0;" vertex="1" parent="1"><mxGeometry x="860" y="680" width="840" height="310" as="geometry"/></mxCell><mxCell id="2.-39" value="&lt;b&gt;Khởi động&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kiểm layout map; đặt .rodata.tokcfg; nạp object; gắn sys_enter, fexit seccomp, sys_exit, sched_process_fork; nạp allow-list từ resolver; lỗi thì dừng (fail closed)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_counter_loader.c (main)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880" y="712" width="380" height="116" as="geometry"/></mxCell><mxCell id="2.-40" value="&lt;b&gt;Mỗi 0,5 s (MONOTONIC + 20 ms)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cộng bộ đếm per-CPU mọi cgroup → cgroup_snapshot_extended; đọc pulse_grams theo lô, lấy cửa sổ đã đóng, xoá theo lô → token_grams; window_end = (W + 1) × 0,5 s + lệch đồng hồ (D2)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_counter_loader.c (drain_grams,&lt;br&gt;print_snapshots)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1300" y="712" width="380" height="116" as="geometry"/></mxCell><mxCell id="2.-41" value="&lt;b&gt;Dòng JSON ra stdout (một frame)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{&quot;type&quot;:&quot;cgroup_snapshot_extended&quot;,&quot;cgroup_id&quot;:…,&quot;total&quot;:…,&quot;counts&quot;:{29 syscall},&quot;syscall_bins&quot;:[64],&quot;transition_bins&quot;:[64],&quot;full_counts&quot;:{…},&quot;seccomp_skipped_or_emulated&quot;:…}&lt;br&gt;{&quot;type&quot;:&quot;token_grams&quot;,&quot;contract&quot;:&quot;pulse-token-select1f-v1&quot;,&quot;cgroup_id&quot;:…,&quot;window&quot;:W,&quot;window_end&quot;:t,&quot;events&quot;:n,&quot;grams&quot;:[[t0,t1,t2,t3,count],…],&quot;session_events&quot;:m,&quot;session&quot;:[…]}&lt;br&gt;{&quot;type&quot;:&quot;token_drain&quot;,…,&quot;insert_fail_cumulative&quot;:0} · {&quot;type&quot;:&quot;stat&quot;,…} · {&quot;type&quot;:&quot;snapshot_end&quot;,&quot;targets&quot;:…,&quot;snapshots&quot;:…}&lt;br&gt;&lt;b&gt;Proof&lt;/b&gt; (scripts/token_probe_proof.py): tổng sự kiện token = tổng full_counts trong cgroup cô lập (bản final: 361.900 / 442.796 / 393.644 trên 3 worker), token mẫu đúng, seccomp như proof matched.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: proof: scripts/token_probe_proof.py, scripts/lineage_probe_proof.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880" y="840" width="800" height="140" as="geometry"/></mxCell><mxCell id="2.-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-39" target="2.-40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-43" value="Kiểu mũi tên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="845" width="820" height="86" as="geometry"/></mxCell><mxCell id="2.-44" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="891" width="1" height="1" as="geometry"/></mxCell><mxCell id="2.-45" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="891" width="1" height="1" as="geometry"/></mxCell><mxCell id="2.-46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B58900;strokeWidth=2;" edge="1" parent="1" source="2.-44" target="2.-45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-47" value="Dữ liệu trong kernel (syscall, map)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="881" width="342" height="22" as="geometry"/></mxCell><mxCell id="2.-48" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="917" width="1" height="1" as="geometry"/></mxCell><mxCell id="2.-49" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="917" width="1" height="1" as="geometry"/></mxCell><mxCell id="2.-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="2.-48" target="2.-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-51" value="Dữ liệu sự kiện (cửa sổ token, decision)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="907" width="342" height="22" as="geometry"/></mxCell><mxCell id="2.-52" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="430" y="891" width="1" height="1" as="geometry"/></mxCell><mxCell id="2.-53" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="474" y="891" width="1" height="1" as="geometry"/></mxCell><mxCell id="2.-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;" edge="1" parent="1" source="2.-52" target="2.-53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-55" value="Ghi lưu trữ (NFS)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="881" width="342" height="22" as="geometry"/></mxCell><mxCell id="2.-56" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="430" y="917" width="1" height="1" as="geometry"/></mxCell><mxCell id="2.-57" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="474" y="917" width="1" height="1" as="geometry"/></mxCell><mxCell id="2.-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="2.-56" target="2.-57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2.-59" value="Điều khiển, cấu hình (đổi chậm, không mang sự kiện)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="907" width="342" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-3" name="3. Worker và mô hình token"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1210" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3.-1" value="&lt;b&gt;Worker chấm điểm và mô hình token lidds-ml-v5-t3 trên cụm&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="3.-2" value="pipeline/matched_worker.py, một unit systemd mỗi worker (3 core, 3 GB). Một mô hình ngôn ngữ mỗi workload; một cửa sổ vượt ngưỡng của workload là báo động." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="3.-3" value="&lt;b&gt;Dòng token_grams từ loader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mỗi 0,5 s, mỗi (cgroup, cửa sổ đã đóng): số sự kiện, danh sách (4 token, số lần)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/matched_worker.py (run)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="300" height="120" as="geometry"/></mxCell><mxCell id="3.-4" value="&lt;b&gt;token_window (collector/token_capture.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kiểm contract, tổng số lần = số sự kiện, ô trống chỉ ở đầu gram; bỏ cgroup ngoài production; dòng sai → issues&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/collector/token_capture.py (token_window,&lt;br&gt;check_grams)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="380" height="120" as="geometry"/></mxCell><mxCell id="3.-5" value="&lt;b&gt;Metadata resolver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/run/sentinel-pulse/cgroups.json: workload_key = namespace/workload:container, pod_uid, revision&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/collector/&lt;br&gt;cgroup_resolver.py; workload_key: sentinel_pulse/&lt;br&gt;collector/capture.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="300" height="120" as="geometry"/></mxCell><mxCell id="3.-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="3.-3" target="3.-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-5" target="3.-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-8" value="Mô hình token (detector/token_model.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#82B366;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="1680" height="420" as="geometry"/></mxCell><mxCell id="3.-9" value="&lt;b&gt;CountTokenLM của workload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;đếm từ normal: c(h, w), c(h), T(h) cho ngữ cảnh 0–3 token&lt;br&gt;mức nền: P(tên) × P(token | tên), cộng ½ (token lạ của tên quen vẫn có xác suất)&lt;br&gt;Witten-Bell nội suy: P_k = (c(h_k, w) + T(h_k) P_{k−1}) / (c(h_k) + T(h_k)), k = 1, 2, 3&lt;br&gt;= TokenLM offline trên dataset tới sai số 1e-12 (có test)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/detector/token_model.py (CountTokenLM); offline: scripts/analysis/&lt;br&gt;lidds_ml_tokens.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="520" height="220" as="geometry"/></mxCell><mxCell id="3.-10" value="&lt;b&gt;Điểm cửa sổ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;mỗi sự kiện: độ bất ngờ −ln P_3&lt;br&gt;s(W) = trung bình top giá trị lớn nhất (gram tính theo số lần); top = 3 (lidds-ml-v5-t3, MODELS.json), v5: 10; ít sự kiện hơn: trung bình tất cả; cửa sổ rỗng: 0&lt;br&gt;ví dụ lượt cuối: tấn công child_ptrace_handshake trong catalog-service, s(W) = 40,50 &amp;gt; τ = 19,30&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/detector/token_model.py (CountTokenLM.window_score)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="520" height="220" as="geometry"/></mxCell><mxCell id="3.-11" value="&lt;b&gt;TokenBranch (cfg tokens.models)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;mỗi workload: đường dẫn mô hình, SHA-256, ngưỡng τ; hash lệch → không nạp&lt;br&gt;s(W) &amp;gt; τ → báo (candidate_alert_preview), một cửa sổ là đủ&lt;br&gt;ghi decision branch=token: token_score, token_threshold, session_events&lt;br&gt;map gram đầy → token_alert_reason = gram_map_overflow trên cửa sổ nặng nhất, cả frame token_incomplete (D1)&lt;br&gt;chấm p50 0,17 s, p95 0,23 s sau khi cửa sổ đóng (12,1 triệu cửa sổ, lượt v6)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/detector/token_model.py (TokenBranch); sentinel_pulse/collector/&lt;br&gt;token_capture.py (MapOverflow)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1160" y="280" width="520" height="220" as="geometry"/></mxCell><mxCell id="3.-12" value="&lt;b&gt;Bảng chữ select1f&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;errno của 27 syscall (stat, lstat, fstat, newfstatat, access, faccessat, open, openat, creat, read, write, writev, ioctl, connect, execve, fcntl, close, rename, renameat, sendfile, unlink, unlinkat, mkdir, kill, recvfrom, shutdown, futex) · mở thành công: chế độ r|w + thư mục đầu · đọc/ghi thành công: min(15, ⌊log2 n⌋) · còn lại: tên. LID-DS 2021 official (t3): recall 97,25%, báo nhầm 0,19%, p95 1,54 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ebpf/pulse_token_ids.h, pulse_tokens.bpf.h; offline: scripts/analysis/lidds_token_cache.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#BDB76B;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1080" height="110" as="geometry"/></mxCell><mxCell id="3.-13" value="cửa sổ token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-4" target="3.-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="250"/><mxPoint x="300" y="250"/></Array></mxGeometry></mxCell><mxCell id="3.-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="3.-9" target="3.-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="3.-10" target="3.-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-16" value="&lt;b&gt;Decision = mô hình token của workload báo (một cửa sổ là đủ)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mỗi decision mang workload_key, pod_uid, container, window_start/end, token_score, token_threshold, run_id, capture_segment, session_events (nhãn stream của cảnh báo); độ trễ kernel → cảnh báo = cuối cửa sổ + thời gian chấm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/matched_worker.py (run)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1680" height="80" as="geometry"/></mxCell><mxCell id="3.-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.83;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-11" target="3.-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-18" value="&lt;b&gt;NFS: segment 30 phút&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decisions.jsonl · tokens.jsonl · issues.jsonl · loader.log · TERMINAL.json (seal)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/matched_worker.py (run, TERMINAL.json)&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="400" height="110" as="geometry"/></mxCell><mxCell id="3.-19" value="&lt;b&gt;Đĩa local của worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decisions.jsonl cho bridge, campaign&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code:&lt;br&gt;sentinel_pulse/pipeline/matched_worker.py (stream_root)&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="800" width="300" height="110" as="geometry"/></mxCell><mxCell id="3.-20" value="&lt;b&gt;Ghi ngoài vòng chấm (async_sink)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;thread nền, fdatasync + FADV_DONTNEED mỗi 30 s; STATUS.json bất đồng bộ; dừng khi hết chỗ trống&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/async_sink.py (AsyncSink, AsyncState)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="780" y="800" width="450" height="110" as="geometry"/></mxCell><mxCell id="3.-21" value="&lt;b&gt;Khoá trước khi chấm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kernel = proof; SHA-256 của loader và object; SHA-256 từng mô hình token và ngưỡng trong CONFIG.json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/matched_worker.py (run),&lt;br&gt;sentinel_pulse/detector/token_model.py (TokenBranch)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1260" y="800" width="440" height="110" as="geometry"/></mxCell><mxCell id="3.-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-16" target="3.-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3.-16" target="3.-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-24" value="&lt;b&gt;Học mô hình (token_branch_fit.py, trước mỗi lượt; lượt cuối: pulse-live-v7-fit-1118):&lt;/b&gt; normal của lượt thu pulse-token-capture-v6-1116 (+ normal của lượt live v5, bỏ −5 s … +25 s quanh mỗi trial) → tách theo workload → đoạn 30 phút chia vào 5 fold → chấm phần giữ ra (top 3) → điểm lớn nhất mỗi khối 60 s mỗi container → bỏ 0,5% cao nhất → Gumbel theo moment → τ ở α′ = 0,0003 → mô hình cuối học trên toàn bộ → MODELS.json (SHA-256, có top). Không đổi trong lượt chạy. Cụm đổi thì thu normal và fit lại (D9)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="1680" height="120" as="geometry"/></mxCell><mxCell id="3.-25" value="Kiểu mũi tên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="1075" width="1100" height="86" as="geometry"/></mxCell><mxCell id="3.-26" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="1121" width="1" height="1" as="geometry"/></mxCell><mxCell id="3.-27" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="1121" width="1" height="1" as="geometry"/></mxCell><mxCell id="3.-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="3.-26" target="3.-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-29" value="Dữ liệu sự kiện (cửa sổ token, decision)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="1111" width="482" height="22" as="geometry"/></mxCell><mxCell id="3.-30" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="1147" width="1" height="1" as="geometry"/></mxCell><mxCell id="3.-31" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="1147" width="1" height="1" as="geometry"/></mxCell><mxCell id="3.-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1" source="3.-30" target="3.-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-33" value="Đường cảnh báo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="1137" width="482" height="22" as="geometry"/></mxCell><mxCell id="3.-34" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="570" y="1121" width="1" height="1" as="geometry"/></mxCell><mxCell id="3.-35" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="614" y="1121" width="1" height="1" as="geometry"/></mxCell><mxCell id="3.-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#888888;" edge="1" parent="1" source="3.-34" target="3.-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-37" value="Ghi lưu trữ (NFS)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="622" y="1111" width="482" height="22" as="geometry"/></mxCell><mxCell id="3.-38" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="570" y="1147" width="1" height="1" as="geometry"/></mxCell><mxCell id="3.-39" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="614" y="1147" width="1" height="1" as="geometry"/></mxCell><mxCell id="3.-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;dashPattern=1 3;" edge="1" parent="1" source="3.-38" target="3.-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3.-41" value="Điều khiển, cấu hình (đổi chậm, không mang sự kiện)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="622" y="1137" width="482" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="4. Đường cảnh báo"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="520" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4.-1" value="&lt;b&gt;Đường cảnh báo: từ decision của worker tới người vận hành&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="4.-2" value="Bridge chạy trên .234 và chỉ đọc decision." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="4.-3" value="&lt;b&gt;Worker ×3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;decisions.jsonl local; chỉ dòng token có &quot;candidate_alert_preview&quot;:true rời worker&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/pipeline/matched_worker.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="250" height="120" as="geometry"/></mxCell><mxCell id="4.-4" value="&lt;b&gt;Alert bridge (ops/alert_bridge.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• bám log decision của từng worker qua SSH&lt;br&gt;• gom đợt theo (pod_uid, container); hết đợt khi im lặng quá resolve_after&lt;br&gt;• push POST /api/v2/alerts lúc mở đợt, làm mới khi còn kéo dài; lỗi → hàng đợi bền push-queue.jsonl, backoff tới 30 s, giữ tới 1 giờ, tiếp tục sau khi khởi động lại (D3)&lt;br&gt;• nhãn stream: session nếu ≥ 50% sự kiện của cửa sổ chạy trên thread session, ngược lại native&lt;br&gt;• đo độ trễ từ preview_emitted_at và window_end (webhook của Alertmanager → deliveries.jsonl)&lt;br&gt;• đường pull (gauge /metrics, scrape 5 s / 30 s) chỉ để so độ trễ: chậm hơn nhiều&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/ops/alert_bridge.py (Streams, Bridge, push_worker, PushQueue, stream_of)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="520" height="230" as="geometry"/></mxCell><mxCell id="4.-5" value="&lt;b&gt;Alertmanager (API v2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;alert SentinelPulseAnomaly với nhãn node, workload, pod_uid, container, episode, stream&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: testbed/k8s/monitoring/sentinel-pulse-alerting.yaml&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="330" height="120" as="geometry"/></mxCell><mxCell id="4.-6" value="&lt;b&gt;Người vận hành&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nhận thông báo hoặc xem dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1260" y="90" width="300" height="120" as="geometry"/></mxCell><mxCell id="4.-7" value="&lt;b&gt;Prometheus / Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scrape gauge /metrics của bridge; dashboard sentinel-pulse-alerts&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: testbed/k8s/monitoring/sentinel-pulse-dashboard.json&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="250" width="330" height="90" as="geometry"/></mxCell><mxCell id="4.-8" value="SSH tail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-3" target="4.-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-9" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-4" target="4.-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1" source="4.-5" target="4.-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-11" value="pull (so sánh)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4.-4" target="4.-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-12" value="Lượt v6: bridge giao 3.233/3.233 đợt, decision → Alertmanager p95 1,21 s; kernel → Alertmanager (push) p95 1,53 s. Lượt cuối, ví dụ trial tấn công 5: Alertmanager nhận 0,14 s sau cuối cửa sổ báo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="840" height="60" as="geometry"/></mxCell><mxCell id="4.-13" value="Kiểu mũi tên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="820" height="60" as="geometry"/></mxCell><mxCell id="4.-14" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="446" width="1" height="1" as="geometry"/></mxCell><mxCell id="4.-15" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="446" width="1" height="1" as="geometry"/></mxCell><mxCell id="4.-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="4.-14" target="4.-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-17" value="Dữ liệu sự kiện (cửa sổ token, decision)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="436" width="342" height="22" as="geometry"/></mxCell><mxCell id="4.-18" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="430" y="446" width="1" height="1" as="geometry"/></mxCell><mxCell id="4.-19" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="474" y="446" width="1" height="1" as="geometry"/></mxCell><mxCell id="4.-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;" edge="1" parent="1" source="4.-18" target="4.-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4.-21" value="Đường cảnh báo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="436" width="342" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-5" name="5. Học và đánh giá"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5.-1" value="&lt;b&gt;Quy trình chọn, xác nhận và đánh giá&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="5.-2" value="Chọn trên dữ liệu development, xác nhận trên dữ liệu khoá; mỗi bước có protocol đăng ký trước (sửa đổi là amendment có giờ và lý do) và biên nhận JSON trong repo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1680" height="22" as="geometry"/></mxCell><mxCell id="5.-3" value="&lt;b&gt;LID-DS 2021 development + CB-DS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chọn bảng chữ token, độ dài gram, top-k, ngưỡng; lidds-ml-v5: development 530/544, 6 báo nhầm; CB-DS 891/891, 3/1.410&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/analysis/lidds_ml_v5.py,&lt;br&gt;lidds_ml_token_crossfit.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-4" value="&lt;b&gt;LID-DS 2021 official&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lidds-ml-v5: 1.238/1.271, 26/7.938 báo nhầm, p95 1,47 s; lidds-ml-v5-t3: 1.236/1.271 (97,25%), 15/7.938 (0,19%), p95 1,54 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/analysis/&lt;br&gt;lidds_ml_v5.py; t3: lidds2019_dev.py (official)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="5.-3" target="5.-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-6" value="&lt;b&gt;LID-DS 2019&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;v5 theo protocol 723/1.162; dung sai nhãn 1 s (amendment, sau lượt chấm) 1.056/1.162; chia 30/70: chọn t3 trên development, holdout 817/841 (97,15%), p95 10,95 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/analysis/lidds2019_dev.py,&lt;br&gt;scripts/lidds2019_amendment1_run.sh&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-4" target="5.-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-8" value="&lt;b&gt;Thu normal + fit trên cụm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pulse-token-capture-v6-1116 (chỉ normal, tải theo lịch) + normal lượt v5 → pulse-live-v7-fit-1118 (t3, 21 mô hình)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/launch_run.sh,&lt;br&gt;scripts/analysis/token_branch_fit.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-6" target="5.-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-10" value="&lt;b&gt;Lượt live v4–v6&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;v6: tập chính 315/315, precision 99,68%, control 1/315, p95 0,45 s; PAD 300: 105/105; lotl 524/525; vòng cải thiện D1–D18 sau đó&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/analysis/pulse_live_v4.py,&lt;br&gt;native_stream.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1140" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-8" target="5.-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-12" value="&lt;b&gt;Lượt live cuối (45 h)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pulse-live-final-1119: diễn tập trước; 945 trial gồm tốc độ chậm 0,1–0,5/s, PAD 300, bật-tắt, lotl, event-generator; 6 h normal cuối đo gánh&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/launch_run.sh (REHEARSAL=1),&lt;br&gt;sentinel_pulse/protocol/&lt;br&gt;pulse-live-final-v1.json&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1420" y="100" width="255" height="150" as="geometry"/></mxCell><mxCell id="5.-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-10" target="5.-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-14" value="Offline (máy phân tích .234, systemd-run có giới hạn bộ nhớ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#9673A6;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="830" height="420" as="geometry"/></mxCell><mxCell id="5.-15" value="&lt;b&gt;Chuyển đổi và chấm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sentinel_pulse/lidds: convert.py&lt;br&gt;lidds_ml_token_alphabets.py (token), lidds_ml_token_crossfit.py (cross-fit)&lt;br&gt;lidds_ml_v5.py (chọn trên development + CB-DS, chấm official một ứng viên)&lt;br&gt;lidds2019_dev.py (2019: split, development, holdout)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="380" height="170" as="geometry"/></mxCell><mxCell id="5.-16" value="&lt;b&gt;Ngưỡng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gumbel theo moment trên điểm lớn nhất giữ ra của cross-fit 5 fold, bỏ 1% cao nhất; v5: α′ = 0,00018, bỏ 1%; t3: α′ = 0,0003, bỏ 0,5%, top 3; moment được chọn trên development sau khi so với Gumbel MLE, GEV, chuẩn, đuôi mũ&lt;br&gt;trên cụm: khối 60 s mỗi container thay cho bản ghi, fold theo đoạn 30 phút&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/analysis/lidds_ml_v4.py (trimmed_gumbel),&lt;br&gt;lidds_ml_v2.py (gumbel, threshold)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="390" height="170" as="geometry"/></mxCell><mxCell id="5.-17" value="&lt;b&gt;Kiểm thêm (development)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chỉ tên syscall 487/544, bỏ cỡ đọc ghi 490/544&lt;br&gt;LSTM lớn không hơn 4-gram&lt;br&gt;thứ tự phát token như probe (probe1f): 530/544&lt;br&gt;luật đếm 4-gram chưa thấy có ngưỡng: ngang mô hình&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="380" height="170" as="geometry"/></mxCell><mxCell id="5.-18" value="&lt;b&gt;Overhead probe token (token-probe-overhead-v1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;benchmark syscall tĩnh, 5 vòng, 3 worker, xoay điều kiện: off / A / B / C / D / D không giám sát&lt;br&gt;lần 1 fexit → va chạm kprobe Tetragon; lần 2 sys_exit; lần 3 đi ngược dentry; báo cáo, không đạt/trượt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: scripts/overhead_ab.sh, testbed/bench/syscall_bench.c,&lt;br&gt;scripts/app_overhead_ab.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="440" y="520" width="390" height="170" as="geometry"/></mxCell><mxCell id="5.-19" value="Trên cụm (lượt live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#9673A6;container=0;" vertex="1" parent="1"><mxGeometry x="870" y="290" width="830" height="420" as="geometry"/></mxCell><mxCell id="5.-20" value="&lt;b&gt;Planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;plan_matched_run.py --token-build --token-models --admin-control --on-off --eventgen [--rehearsal] → CONFIG.json bất biến; launch_run.sh cài worker, bridge, traffic, campaign, bộ ghi sự kiện K8s (system unit)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="890" y="330" width="380" height="170" as="geometry"/></mxCell><mxCell id="5.-21" value="&lt;b&gt;Fit trước lượt live&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;token_branch_fit.py → MODELS.json (mô hình token + ngưỡng mỗi workload)&lt;br&gt;--extra-run: thêm normal của lượt trước, bỏ −5 s … +25 s quanh mỗi trial&lt;br&gt;khoá sha256 trước lượt live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1290" y="330" width="390" height="170" as="geometry"/></mxCell><mxCell id="5.-22" value="&lt;b&gt;Chấm lượt live&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;trial phát hiện khi có báo động trong [start, start + 15 s]; đợt = báo động cùng container cách nhau &lt; 15 s; gánh = đợt / replica-giờ ngoài khoảng campaign; Wilson, bootstrap theo workload; pulse_live_v4.py, native_stream.py, live_attribution.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="890" y="520" width="380" height="170" as="geometry"/></mxCell><mxCell id="5.-23" value="&lt;b&gt;Gate cho binary vô hại (đã loại)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mô hình gộp mọi workload, giữ 1–2 s sau execve, ngưỡng theo pha: không giữ được kết quả LID-DS (development 315–509/544) → hệ thống không có gate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#1F4E79&quot;&gt;&lt;i&gt;code: sentinel_pulse/detector/token_model.py (TokenBranch gate),&lt;br&gt;scripts/analysis/token_branch_fit.py&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B3B3B3;dashed=1;fontColor=#888888;arcSize=8;fontSize=12;align=left;spacing=4;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1290" y="520" width="390" height="170" as="geometry"/></mxCell><mxCell id="5.-24" value="Bằng chứng và tài liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1680" height="230" as="geometry"/></mxCell><mxCell id="5.-25" value="&lt;b&gt;Protocol&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sentinel_pulse/protocol/*.json, đăng ký trước khi có dữ liệu; amendment ghi rõ lý do&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-26" value="&lt;b&gt;Biên nhận&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;validation-evidence/results-YYYYMMDD/*: JSON, bảng, log; seal SHA-256 của segment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-27" value="&lt;b&gt;Audit số liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scripts/audit/headline_numbers.py: mọi số trong bản LaTeX khớp biên nhận&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-28" value="&lt;b&gt;Đồ án&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;thesis/ (LaTeX, tectonic); báo cáo và slide họp trong docs/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1030" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-29" value="&lt;b&gt;Ghi chép&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;notes/STATE.md (trạng thái), notes/WORKLOG.md (nhật ký từng bước), docs/LUONG_CODE.md (luồng code, lệnh)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=8;fontSize=12;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1360" y="775" width="310" height="100" as="geometry"/></mxCell><mxCell id="5.-30" value="Nguyên tắc: chọn trên development, official và lượt live chỉ để xác nhận; mỗi lần chấm lại official phải khai báo; holdout LID-DS 2019 đã được v5 chấm trước khi chia (công bố trong mọi tài liệu); không job nặng nào chạy cùng lượt live; số liệu chỉ lấy từ biên nhận." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1640" height="60" as="geometry"/></mxCell><mxCell id="5.-31" value="Kiểu mũi tên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;strokeWidth=2;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="1100" height="60" as="geometry"/></mxCell><mxCell id="5.-32" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="1036" width="1" height="1" as="geometry"/></mxCell><mxCell id="5.-33" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="1036" width="1" height="1" as="geometry"/></mxCell><mxCell id="5.-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="5.-32" target="5.-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-35" value="Bước tiếp theo, chấm trên dữ liệu khoá" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="84" y="1026" width="482" height="22" as="geometry"/></mxCell><mxCell id="5.-36" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="570" y="1036" width="1" height="1" as="geometry"/></mxCell><mxCell id="5.-37" value="" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="614" y="1036" width="1" height="1" as="geometry"/></mxCell><mxCell id="5.-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" edge="1" parent="1" source="5.-36" target="5.-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5.-39" value="Bước tiếp theo, development hoặc cụm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="622" y="1026" width="482" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
