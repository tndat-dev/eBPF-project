[Unit]
Description=AIMS V8 frozen blind attack and paired feature capture
After=network-online.target aims-v8-post-capture.service
Wants=network-online.target
ConditionPathExists=/home/dat/ml-service/aims-v8-derived-v8-paired-replay-20260811/POST_CAPTURE_COMPLETE
ConditionPathExists=!/home/dat/ml-service/aims-v8-blind-attack-v8-paired-replay-20260811/v8-blind-attack-20260811/report.json

[Service]
Type=oneshot
User=dat
Group=dat
WorkingDirectory=/home/dat/ml-service
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/usr/bin/flock -n -E 75 /home/dat/ml-service/.aims-v8-blind-attack.lock /home/dat/ml-service/run_v8_blind_attack.sh
SuccessExitStatus=75 8
TimeoutStartSec=72h
Nice=15
CPUQuota=150%
MemoryMax=8G
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dat/ml-service

[Install]
WantedBy=multi-user.target
