[Unit]
Description=AIMS V8 guarded candidate fit and terminal normal evaluation
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/dat/v8-post-capture-staging/v8-paired-replay-20260811/STAGING_SHA256SUMS
ConditionPathExists=!/home/dat/ml-service/aims-v8-derived-v8-paired-replay-20260811/POST_CAPTURE_COMPLETE

[Service]
Type=oneshot
User=dat
Group=dat
WorkingDirectory=/home/dat/ml-service
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/usr/bin/flock -n -E 75 /home/dat/ml-service/.aims-normal-matrix.lock /home/dat/v8-post-capture-staging/v8-paired-replay-20260811/ml-service/deploy_and_run_v8_post_capture.sh
SuccessExitStatus=75
TimeoutStartSec=36h
Nice=15
CPUQuota=100%
MemoryMax=8G
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dat/ml-service

[Install]
WantedBy=multi-user.target
