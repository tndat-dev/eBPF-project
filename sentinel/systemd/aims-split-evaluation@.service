[Unit]
Description=AIMS frozen %i evaluation (no training or promotion)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dat
Group=dat
WorkingDirectory=/home/dat/ml-service
EnvironmentFile=/home/dat/ml-service/aims-evaluation.env
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/usr/bin/flock -n -E 75 /home/dat/ml-service/.aims-split-evaluation.lock /home/dat/ml-service/run_aims_split_evaluation.sh %i
SuccessExitStatus=75
TimeoutStartSec=6h
Nice=15
CPUQuota=100%
MemoryMax=8G
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dat/ml-service

[Install]
WantedBy=multi-user.target
