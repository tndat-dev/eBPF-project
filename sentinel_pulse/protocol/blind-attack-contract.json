    "trials": [
      {"rate_per_second": 6, "seed": 11003},
      {"rate_per_second": 12, "seed": 13001},
      {"rate_per_second": 24, "seed": 17011},
      {"rate_per_second": 12, "seed": 19001},
      {"rate_per_second": 6, "seed": 23003}
