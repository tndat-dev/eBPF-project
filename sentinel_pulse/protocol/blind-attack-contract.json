      "aims-rabbitmq-server",
      "aims-redis",
      "aims-redis-sentinel-sentinel",
      "aims-waypoint",
      "api-gateway",
      "auth-service",
      "cart-service",
      "catalog-service",
      "inventory-service",
      "notification-service",
      "order-service",
      "payment-service",
      "security-telemetry-service"
