[Unit]
Description=Separate multiregime syscall frequency capture after protected normal soak
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/sentinel-pulse-archive
StartLimitIntervalSec=0

[Service]
Type=simple
User=dat
Group=dat
WorkingDirectory=/home/dat/pulse-syscall-capture-c3/source
EnvironmentFile=/etc/sentinel-pulse/syscall-capture-c3.env
Environment=PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ExecStart=/home/dat/sentinel-pulse-syscall-feature-c1/venv/bin/python -u -m sentinel_pulse.syscall_capture_campaign --root /mnt/sentinel-pulse-archive/syscall-capture-c3-r2 --source /home/dat/pulse-syscall-capture-c3/source --credential /home/dat/.pulse-recovery-credential-20261005 --source-commit ${PULSE_SOURCE_COMMIT}
Restart=on-failure
RestartSec=60
TimeoutStopSec=30
CPUQuota=100%
MemoryMax=2G
MemorySwapMax=0
Nice=15
UMask=0077

[Install]
WantedBy=multi-user.target
