[Unit]
Description=Read-only summary of completed Pulse shadow soak (%i)
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/dat/pulse-shadow-summary-20261014/source-r2
EnvironmentFile=/etc/sentinel-pulse/normal-soak-%i.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u -m sentinel_pulse.shadow_soak_summary --capture /var/lib/sentinel-pulse-normal-%i/capture --decisions /var/lib/sentinel-pulse-normal-%i/shadow/decisions.jsonl --output /var/lib/pulse-shadow-review/%i-r2 --run-id ${PULSE_RUN_ID} --manifest-sha256 747c4eed2a9a74321d0ac3b716c201c449f946665252baa1ca314b1f18278a08 --policy-sha256 fd0be94a4ca7f2cd64b97bf5c7dc074763405f821ab346e8e19bb5975d10f401
Restart=on-failure
RestartSec=60
TimeoutStartSec=infinity
CPUQuota=50%
MemoryMax=256M
MemorySwapMax=0
Nice=19
IOWeight=1
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/pulse-shadow-review
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
