# Frozen capture metadata is versioned; raw telemetry is retained outside Git
# because individual campaign feature streams can exceed GitHub's size limit.
validation-evidence/**/features.jsonl
validation-evidence/**/*.pkl
validation-evidence/**/decisions.jsonl
validation-evidence/**/alerts.jsonl
validation-evidence/**/MONITOR.jsonl

# Raw observers and API payloads remain on VM/host, outside the Git publication.
# Receipts, digests and adjudication reports are still versioned.
validation-evidence/**/clock.jsonl
validation-evidence/**/runtime.txt
validation-evidence/**/journal.txt
validation-evidence/**/PREFLIGHT_PRODUCTION_PODS.json
validation-evidence/**/FAILURE_PRODUCTION_PODS.json
validation-evidence/**/workload-pods-start.json
validation-evidence/**/WORKLOAD_FINGERPRINT_OBSERVED.json

# Claude Code local settings (per-machine permissions)
.claude/settings.local.json

# Paper PDFs: the repository is public and most papers may not be redistributed; references/catalog.json
# records URL, SHA-256 and size of every local copy (scripts/fetch_references.py).
references/pdf/
# LibreOffice lock files of an open document
.~lock.*#
